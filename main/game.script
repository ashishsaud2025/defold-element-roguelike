-- /main/game.script
-- Main simulation + state machine. See MASTER_PROMPT sections 5, 6.
-- Flow: TITLE -> PICK_START -> ROOM -> REWARD -> CAULDRON -> ROOM -> ... -> BOSS -> WIN
--                                              \-> DEAD -> TITLE
local selfcheck = require "src.core.selfcheck"
local data = require "src.core.data"
local skillgen = require "src.core.skillgen"
local player_mod = require "src.game.player"
local enemies_mod = require "src.game.enemies"
local level_mod = require "src.game.level"
local rooms_mod = require "src.levels.rooms"
local art_mod = require "src.core.art"
local FX = art_mod.FX
-- Spec 6.3: element-specific effect art. index 1 = element A (trail/rise),
-- index 2 = element B (hit/spoke). Falls back to ELEMENT_FALLBACK (then FX.glow).
local DIRECTIONAL_FX = { fx_streak = true }   -- art that must be rotated onto the flight direction
local function element_fx(elements, index, role)
    local name = elements and elements[index]
    local set = name and art_mod.ELEMENT_FX and art_mod.ELEMENT_FX[name]
    return (set and set[role])
        or (art_mod.ELEMENT_FALLBACK and art_mod.ELEMENT_FALLBACK[role])
        or FX.glow
end
local anim_mod = require "src.game.anim"
local fxanim = require "src.core.fxanim"   -- generated by tools/build_fx_anim.py
local combat_mod = require "src.game.combat"
local status_mod = require "src.core.status"
local reactions_mod = require "src.core.reactions"
local events = require "src.game.events"
local sfx = require "src.core.sfx"
local music = require "src.core.music"
local credits_lines = require "src.core.credits"

-- Forward declaration: apply_hit is defined after apply_reaction (needed for AoE reactions).
local apply_hit

local ARENA_W = data.TUNING.ARENA_W
local ARENA_H = data.TUNING.ARENA_H
local MARGIN = data.TUNING.ARENA_MARGIN

local ELEMENT_LIST = { "fire", "water", "wind", "earth" }
local SHAPE_LIST = { "projectile", "puddle", "orbit", "cone", "burst" }
local SHAPE_DISPLAY = { projectile = "Bolt", puddle = "Pool", orbit = "Orbit", cone = "Spray", burst = "Nova" }

local PLAYER_RADIUS = 12
local ENEMY_BASE_TINT = { r = 0.5, g = 0.5, b = 0.5 }

-- Statuses are shown with a tint (4.4). First match in this list wins.
local TINT_PRIORITY = { "stun", "root", "burn", "slow", "blind", "confuse", "pull", "push" }

-- Returns (status_name, color) for an enemy's highest-priority visible status.
local function visible_status_tint(e)
    if e.statuses then
        for _, name in ipairs(TINT_PRIORITY) do
            if e.statuses[name] then
                local def = status_mod.def(name)
                if def and def.color then return name, def.color end
            end
        end
    end
    return nil, nil
end

-- ===== VFX + environment helpers (additive glow sprites, procedural arena) =====
local function lerp(a, b, t) return a + (b - a) * t end

-- Additive glow sprite from the fx factory. Returns the instance id.
-- (Glow art is white; r,g,b,a tint it. Additive blending makes it pop on dark floors.)
local function fx_make(x, y, z, anim, r, g, b, a, scale)
    local id = factory.create("#fx_factory", vmath.vector3(x, y, z or 0.1))
    local url = msg.url(nil, id, "sprite")
    sprite.play_flipbook(url, hash(anim or FX.glow))
    go.set(url, "tint", vmath.vector4(r or 1, g or 1, b or 1, a or 1))
    go.set_scale(vmath.vector3(scale or 1, scale or 1, 1), id)
    return id
end

local function del_bolt(p)
    if p.id then go.delete(p.id) end
    if p.glow then go.delete(p.glow) end
    if p.flame then go.delete(p.flame) end
end

-- Short-lived fading/shrinking/growing glow. scale -> end_scale over `life` seconds.
-- `rot` (optional) rotates the sprite (radians, cosmetic only) at spawn.
local function spawn_particle(self, x, y, r, g, b, a, scale, life, vx, vy, art, end_scale, rot)
    if #self.particles >= 260 then return end
    local s0 = scale or 0.4
    local id = fx_make(x, y, 0.1, art or data.ART.particle.spark, r or 1, g or 1, b or 1, a or 1, s0)
    if rot then go.set_rotation(vmath.quat_rotation_z(rot), id) end
    table.insert(self.particles, {
        id = id, x = x, y = y, life = life or 0.5, max_life = life or 0.5,
        vx = vx or 0, vy = vy or 0,
        r = r or 1, g = g or 1, b = b or 1, a = a or 1,
        s0 = s0, s1 = end_scale or s0 * 0.4,
    })
end

-- `hit_art` (optional) overrides the central star with element B's hit sprite (spec 6.3).
local anim_fx   -- forward declaration (defined below the particle helpers)

local function fx_hit(self, x, y, c, hit_art, skill)
    if skill and skill.elements then
        -- Animated impact in element B's colours; the family is chosen per compound.
        local st = fxanim.COMPOUND[skill.compound]
        if st then anim_fx(self, x, y, st.hit, skill.elements[2], 76, nil, { z = 0.14 }) end
    end
    spawn_particle(self, x, y, c.r, c.g, c.b, 0.9, 0.55, 0.2, 0, 0, FX.glow, 0.15)
    spawn_particle(self, x, y, 1, 1, 1, 0.9, 0.5, 0.16, 0, 0, hit_art or data.ART.particle.star, 0.8)
    for _ = 1, 4 do
        local a = math.random() * math.pi * 2
        local sp = 110 + math.random() * 150
        spawn_particle(self, x, y, c.r, c.g, c.b, 1, 0.35, 0.3, math.cos(a) * sp, math.sin(a) * sp, FX.glow, 0.04)
    end
end

local function fx_kill(self, x, y, c, enemy)
    events.emit("kill", { self = self, enemy = enemy, x = x, y = y, color = c })
    spawn_particle(self, x, y, c.r, c.g, c.b, 0.9, 0.3, 0.4, 0, 0, data.ART.particle.circle, 2.0)
    spawn_particle(self, x, y, 1, 0.95, 0.85, 1, 1.0, 0.25, 0, 0, data.ART.particle.scorch, 1.6)
    for _ = 1, 9 do
        local a = math.random() * math.pi * 2
        local sp = 90 + math.random() * 200
        spawn_particle(self, x, y, c.r, c.g, c.b, 1, 0.5, 0.5, math.cos(a) * sp, math.sin(a) * sp, data.ART.particle.star, 0.05)
    end
end

local function fx_player_hit(self)
    local p = self.player_pos
    events.emit("player_hit", { self = self, x = p.x, y = p.y })
    spawn_particle(self, p.x, p.y, 1, 0.25, 0.25, 1, 0.4, 0.35, 0, 0, data.ART.particle.circle, 2.2)
    spawn_particle(self, p.x, p.y, 1, 0.3, 0.3, 0.8, 1.2, 0.25, 0, 0, FX.glow, 0.3)
end

local function fx_cast(self, x, y, c, skill)
    spawn_particle(self, x, y, c.r, c.g, c.b, 0.9, 0.7, 0.14, 0, 0, FX.glow, 0.2)
    if skill and skill.elements then
        anim_fx(self, x, y, fxanim.CAST, skill.elements[1], 60, nil, { z = 0.13 })
    end
end

-- ===== The one choke point for every hit (P1) =====
-- All six delivery paths (bolt, puddle tick, orbit, cone, burst, delayed echo)
-- and burn ticks go through here. It preserves exactly what the copies did:
--   * damage via combat_mod.apply_damage (kills, splitter children, boss death)
--   * statuses via status_mod.apply (returns the fresh applications)
--   * push/pull knockback 260 away from / toward src (echo opts out, as before)
--   * fx_hit at src.fx_x/fx_y or the enemy position (only where the old code had it)
--   * the original "Enemy died" / "Enemy HP: n" console lines
-- It then emits "status" (once per fresh status) and one "hit" event.
-- src = { kind, x, y, kx, ky, skill, color, hit_art, fx, fx_x, fx_y,
--         knockback (false to skip), silent_log (true for burn ticks) }
local function apply_reaction(self, e, rx, src, skill, damage)
    if not rx then return end
    reactions_mod.consume(e, rx)
    
    -- Play sound
    if rx.sound then
        sfx.play(rx.sound, { x = e.x })
    end
    
    local x, y = e.x, e.y
    
    if rx.effect == "aoe" then
        -- Steam Burst: AoE damage to nearby enemies
        local radius = rx.radius or 60
        local aoe_dmg = math.max(rx.min_damage or 4, (skill and skill.power or damage or 1) * (rx.damage_mul or 0.6))
        local targets = {}
        for _, other in ipairs(self.enemies or {}) do
            if other ~= e and other.alive then
                local dx = other.x - x
                local dy = other.y - y
                local dist = math.sqrt(dx * dx + dy * dy)
                if dist <= radius then
                    table.insert(targets, other)
                end
            end
        end
        for _, other in ipairs(targets) do
            apply_hit(self, other, aoe_dmg, rx.apply or {}, {
                kind = "reaction_aoe",
                x = x, y = y,
                skill = skill,
                knockback = false,
                silent_log = true,
            })
        end
        -- Apply blind to primary target
        if rx.apply and #rx.apply > 0 then
            status_mod.apply(e, rx.apply, 0)
        end
    elseif rx.effect == "bonus" then
        -- Shatter: bonus damage
        local bonus = (skill and skill.power or damage or 1) * (rx.bonus_mul or 0.75)
        combat_mod.apply_damage(e, bonus)
        if rx.apply and #rx.apply > 0 then
            status_mod.apply(e, rx.apply, 0)
        end
    elseif rx.effect == "flare" then
        -- Flare-up: burn dps x2 for duration
        if e.statuses and e.statuses.burn then
            e.statuses.burn.dps_mul = rx.burn_mul or 2.0
            e.statuses.burn.flare_expiry = rx.duration or 3.0
        end
        if rx.spread_radius then
            e.spread_radius = rx.spread_radius
        end
    elseif rx.effect == "convert" then
        -- Bog: convert slow to root
        if e.statuses and e.statuses.slow then
            e.statuses.slow = nil
        end
        status_mod.apply(e, { rx.convert_to }, 0)
        if e.statuses and e.statuses[rx.convert_to] then
            e.statuses[rx.convert_to].expiry = rx.convert_duration or 2.0
        end
    elseif rx.effect == "knockback" then
        -- Whirl: knockback + confuse
        local kvx, kvy = combat_mod.knockback(e.x, e.y, x, y, 260, false)
        local dist = rx.knockback_dist or 140
        local dx = e.x - x
        local dy = e.y - y
        local d = math.sqrt(dx * dx + dy * dy)
        if d > 0 then
            e.vx = (e.vx or 0) + kvx + (dx / d) * dist
            e.vy = (e.vy or 0) + kvy + (dy / d) * dist
        else
            e.vx = (e.vx or 0) + kvx
            e.vy = (e.vy or 0) + kvy
        end
        if rx.apply and #rx.apply > 0 then
            status_mod.apply(e, rx.apply, 0)
            for _, name in ipairs(rx.apply) do
                if e.statuses and e.statuses[name] then
                    e.statuses[name].expiry = rx.apply_duration or 2.0
                end
            end
        end
    end
end

apply_hit = function(self, e, damage, statuses, src)
    src = src or {}
    
    -- Reaction check (before applying hit's own statuses)
    local skill = src.skill
    local rx_list = {}
    if skill and e.alive then
        local r = reactions_mod.check(e, skill)
        rx_list = {}
        for _, rx in ipairs(r) do table.insert(rx_list, rx) end
        if skill.compound == "Inferno" and src.kind == "bolt" then
            _G._inferno_rx = _G._inferno_rx or {}
            table.insert(_G._inferno_rx, #rx_list)
        end
    end
    
    -- Frame-level limits: at most 3 reactions per frame; no AoE chain
    self.reaction_count = self.reaction_count or 0
    self.aoe_this_frame = self.aoe_this_frame or false
    local filtered = {}
    for _, rx in ipairs(rx_list) do
        if self.reaction_count >= 3 then break end
        if rx.effect == "aoe" and self.aoe_this_frame then
            -- skip AoE if one already fired this frame
        else
            table.insert(filtered, rx)
            self.reaction_count = self.reaction_count + 1
            if rx.effect == "aoe" then self.aoe_this_frame = true end
        end
    end
    rx_list = filtered
    
    -- Apply reactions (before hit's own statuses)
    for _, rx in ipairs(rx_list) do
        apply_reaction(self, e, rx, src, skill, damage)
    end
    
    local died = combat_mod.apply_damage(e, damage)
    
    local fresh = nil
    if statuses and #statuses > 0 then
        fresh = status_mod.apply(e, statuses, 0)
    end

    if src.knockback ~= false and e.statuses then
        local toward = nil
        if e.statuses.push then toward = false
        elseif e.statuses.pull then toward = true end
        if toward ~= nil then
            local kx = src.kx or src.x or e.x
            local ky = src.ky or src.y or e.y
            local kvx, kvy = combat_mod.knockback(e.x, e.y, kx, ky, 260, toward)
            e.vx = kvx
            e.vy = kvy
        end
    end

    if src.fx then
        fx_hit(self, src.fx_x or e.x, src.fx_y or e.y,
            src.color or { r = 1, g = 1, b = 1 }, src.hit_art, src.skill)
    end

    if not src.silent_log then
        if died then print("Enemy died") else print("Enemy HP: " .. e.hp) end
    end

    if fresh then
        for _, name in ipairs(fresh) do
            events.emit("status", { self = self, enemy = e, name = name, x = e.x, y = e.y, skill = src.skill })
        end
    end
    events.emit("hit", { self = self, enemy = e, damage = damage, statuses = statuses, src = src, died = died })
    if src.kind == "bolt" and src.skill and src.skill.compound == "Inferno" then
        _G._inferno_emit_hit = (_G._inferno_emit_hit or 0) + 1
    end
    return died
end

-- Statuses applied outside apply_hit (spread, wall stun, hide_self) still need to
-- reach the bus, but only for fresh applications.
local function apply_status(self, target, names)
    local fresh = status_mod.apply(target, names, 0)
    for _, name in ipairs(fresh) do
        events.emit("status", {
            self = self, enemy = target, name = name, x = target.x, y = target.y,
        })
    end
    return fresh
end

-- ===== Audio listeners (P3) =====
-- The bus is synchronous; these are registered once in init. All audio goes through
-- src/core/sfx.lua, so a missing backend / disabled audio simply returns false.
local function on_hit_audio(ctx)
    local src = ctx.src or {}
    -- Burn and pool ticks are intentionally silent (MASTER_PROMPT P3 item 2).
    if src.kind == "burn" or src.kind == "puddle" then return end
    local skill = src.skill
    if not skill then return end
    local power = skill.power or 1
    local strength = 1
    if power > 0 then strength = math.min(1, (ctx.damage or power) / power) end
    local x = (ctx.enemy and ctx.enemy.x) or src.x or src.fx_x
    sfx.hit(skill, x, strength)
end

local function on_status_audio(ctx)
    if not ctx.name then return end
    local x = (ctx.enemy and ctx.enemy.x) or ctx.x
    sfx.status(ctx.name, x)
end

local function on_quirk_audio(ctx)
    local q = ctx.quirk
    if not q then return end
    sfx.quirk(q, ctx.x)
    if q == "costs 5% health" then
        sfx.play("pl_hurt", { x = ctx.x, gain = 0.4 })
    end
end

-- ===== World audio listeners (P4) =====
-- World sounds use spatial pan from the enemy/player x position; UI sounds are centred.

local function on_player_hit_audio(ctx)
    local x = ctx.x or (ctx.self and ctx.self.player_pos and ctx.self.player_pos.x)
    sfx.play("pl_hurt", { x = x })
end

local function on_dash_audio(ctx)
    local x = ctx.x or (ctx.self and ctx.self.player_pos and ctx.self.player_pos.x)
    sfx.play("pl_dash", { x = x })
end

local function on_enemy_spawn_audio(ctx)
    local e = ctx.enemy
    if not e then return end
    local x = e.x or 0
    sfx.play("en_spawn", { x = x })
    local t = e.type
    if t == "brute" then
        sfx.play("en_brute_stomp", { x = x })
    elseif t == "boss" then
        sfx.play("boss_roar", { x = x })
    end
end

local function on_kill_audio(ctx)
    local e = ctx.enemy
    if not e then return end
    local x = (e and e.x) or 0
    if e.type == "boss" then
        sfx.play("boss_die", { x = x })
    elseif e.type == "splitter" then
        sfx.play("en_splitter_pop", { x = x })
    else
        sfx.play("en_die", { x = x })
    end
end

local function on_room_clear_audio(ctx)
    local x = (ctx.self and ctx.self.player_pos and ctx.self.player_pos.x) or ARENA_W * 0.5
    sfx.play("room_clear", { x = x })
    if ctx.boss then
        sfx.play("boss_die", { x = x })
    end
end

-- ===== Animated skill effects (flipbooks from the downloaded packs) =====
-- One-shot flipbooks live in self.anims and are deleted when their animation has finished.
-- Sizes come from src/core/fxanim.lua (generated). Everything here is cosmetic only.
local ANIM_CAP = 90                       -- sprite budget (AGENTS #23); extra effects are skipped
local MAX_PIXEL_SCALE = 3.5               -- never blow 64px art up beyond this
local FLAME_TINT = {                      -- fire-pack flames: earth uses the yellow flame, tinted brown
    fire = { 1, 1, 1 }, water = { 1, 1, 1 }, wind = { 1, 1, 1 }, earth = { 0.95, 0.66, 0.38 },
}

-- Plays animation `fam`/`elem` once. px = on-screen diameter in pixels. opts: name, z, tint, a, alpha, vx, vy.
function anim_fx(self, x, y, fam, elem, px, rot, opts)
    if art_mod.ANIM_FX == false then return nil end
    opts = opts or {}
    local name = opts.name or ("fxa_" .. fam .. "_" .. elem)
    local info = fxanim.ANIMS[name]
    if not info or #self.anims >= ANIM_CAP then return nil end
    local z = opts.z or 0.12
    local id = factory.create(opts.alpha and "#visual_factory" or "#fx_factory", vmath.vector3(x, y, z))
    local url = msg.url(nil, id, "sprite")
    sprite.play_flipbook(url, hash(name))
    local t = opts.tint or { 1, 1, 1 }
    go.set(url, "tint", vmath.vector4(t[1], t[2], t[3], opts.a or 1))
    local sc = 1
    if px and px > 0 then sc = math.min(px / info.size, MAX_PIXEL_SCALE) end
    go.set_scale(vmath.vector3(sc, sc, 1), id)
    if rot then go.set_rotation(vmath.quat_rotation_z(rot), id) end
    table.insert(self.anims, { id = id, t = info.dur + 0.04, x = x, y = y, z = z, vx = opts.vx or 0, vy = opts.vy or 0 })
    return id
end

-- Alpha-blended smoke puff for the vapour compounds (Steam, Mist, Dust, Mud). Deterministic variation.
local function smoke_puff(self, x, y, skill, px, vx, vy)
    local st = skill and fxanim.COMPOUND[skill.compound]
    if not (st and st.smoke) then return end
    local fam = (math.floor(x * 0.13 + y * 0.17) % 2 == 0) and "smoke_a" or "smoke_b"
    anim_fx(self, x, y, fam, nil, px, nil, { name = "fxa_" .. fam, alpha = true, tint = st.smoke,
        a = 0.7, z = 0.09, vx = vx, vy = vy })
end

-- Looping flame (bolt head / orbit orb) in an element's colours. Returns the instance id.
local function flame_make(x, y, kind, elem, px)
    local name = "fxa_" .. kind .. "_" .. elem
    local info = fxanim.ANIMS[name]
    if not info or art_mod.ANIM_FX == false then return nil end
    local t = FLAME_TINT[elem] or FLAME_TINT.fire
    local id = fx_make(x, y, 0.11, name, t[1], t[2], t[3], 1, px / info.size)
    return id
end

-- Per-room colour themes: floor tint, accent (wall edge glow, sigil, motes).
local PALETTES = {
    { floor = { 0.30, 0.26, 0.50 }, accent = { 0.60, 0.45, 1.00 } },  -- 1 violet
    { floor = { 0.20, 0.36, 0.42 }, accent = { 0.30, 0.90, 0.95 } },  -- 2 teal
    { floor = { 0.44, 0.22, 0.26 }, accent = { 1.00, 0.40, 0.35 } },  -- 3 crimson
    { floor = { 0.24, 0.40, 0.26 }, accent = { 0.50, 1.00, 0.50 } },  -- 4 forest
    { floor = { 0.24, 0.30, 0.50 }, accent = { 0.45, 0.65, 1.00 } },  -- 5 azure
    { floor = { 0.46, 0.34, 0.20 }, accent = { 1.00, 0.75, 0.30 } },  -- 6 amber
    { floor = { 0.44, 0.22, 0.44 }, accent = { 1.00, 0.45, 0.95 } },  -- 7 magenta
    { floor = { 0.30, 0.34, 0.40 }, accent = { 0.75, 0.90, 1.00 } },  -- 8 steel
    { floor = { 0.30, 0.12, 0.16 }, accent = { 1.00, 0.25, 0.30 } },  -- 9 boss
}

-- Tint multipliers per tile kind (only applied to tiles whose art manifest says tint = true).
-- The textured Tiny Dungeon tiles are darker than the generated placeholders, so these are
-- higher than the old values; the palette still decides the hue.
local KIND_TINT = { floor = 0.90, wall_face = 0.75, wall_top = 0.50, pillar = 1.00 }

local function apply_palette(self, room)
    local pal = PALETTES[math.max(1, math.min(room or 1, #PALETTES))]
    local f, a = pal.floor, pal.accent
    self.accent = a
    for _, t in ipairs(self.level_tiles or {}) do
        if t.accent then
            go.set(t.url, "tint", vmath.vector4(a[1], a[2], a[3], t.a))
        elseif t.tinted then
            local m = (KIND_TINT[t.kind] or 0.4) * (t.k or 1)
            go.set(t.url, "tint", vmath.vector4(f[1] * m, f[2] * m, f[3] * m, 1))
        end
    end
    for _, e in ipairs(self.accent_urls or {}) do
        go.set(e.url, "tint", vmath.vector4(a[1], a[2], a[3], e.a))
    end
end

local function clear_level_visuals(self)
    for _, t in ipairs(self.level_tiles or {}) do go.delete(t.id) end
    for _, t in ipairs(self.torches or {}) do go.delete(t.id) end
    self.level_tiles, self.torches = {}, {}
end

-- Build (or rebuild) the tile sprites for room `idx` and make it the active level.
local function set_room_visuals(self, idx)
    local def = rooms_mod[math.max(1, math.min(idx, #rooms_mod))]
    local lv = level_mod.parse(def.rows)
    lv.name = def.name
    self.level = lv
    clear_level_visuals(self)
    local TS = level_mod.TS
    local T = art_mod.TILES

    local function tile(kind, art, cx, cy, z, k)
        local id = factory.create("#visual_factory", vmath.vector3(cx, cy, z))
        local url = msg.url(nil, id, "sprite")
        sprite.play_flipbook(url, hash(art.anim))
        go.set_scale(vmath.vector3(art.scale, art.scale, 1), id)
        table.insert(self.level_tiles, { id = id, url = url, kind = kind, tinted = art.tint, k = k })
        return id
    end

    for r = 1, level_mod.ROWS do
        for c = 1, level_mod.COLS do
            local ch = lv.grid[r][c]
            local cx, cy = level_mod.cell_center(c, r)
            local k = 0.88 + (((c * 7 + r * 13) % 5) / 5) * 0.24
            if ch == "#" or ch == "T" then
                local floor_below = (r < level_mod.ROWS) and not level_mod.is_solid_cell(lv, c, r + 1)
                if floor_below then
                    tile("wall_face", T.wall_face, cx, cy, -0.7, k)
                    -- glowing accent line where the wall meets the floor
                    local id = fx_make(cx, cy - TS * 0.5 + 1, -0.65, FX.square, 1, 1, 1, 0.5, 1)
                    go.set_scale(vmath.vector3(TS / 64, 2 / 64, 1), id)
                    table.insert(self.level_tiles, { id = id, url = msg.url(nil, id, "sprite"), accent = true, a = 0.5 })
                else
                    tile("wall_top", T.wall_top, cx, cy, -0.7, k)
                end
                if ch == "T" then
                    local tid = tile("torch", T.torch, cx, cy, -0.6, 1)
                    local g = fx_make(cx, cy, -0.55, FX.glow, 1.0, 0.65, 0.25, 0.4, 2.2)
                    table.insert(self.torches, { id = g, url = msg.url(nil, g, "sprite"), phase = c * 1.3 })
                end
            else
                local variant = (((c * 5 + r * 3) % 7) == 0) and T.floor_b or T.floor_a
                tile("floor", variant, cx, cy, -0.8, k)
                if ch == "O" then tile("pillar", T.pillar, cx, cy, -0.4, 1) end
            end
        end
    end
    apply_palette(self, idx)
    return lv
end

-- Sigil, motes, vignette. The tile floor/walls are built per room by set_room_visuals.
local function build_environment(self)
    local W, H = ARENA_W, ARENA_H
    self.level_tiles, self.accent_urls, self.torches = {}, {}, {}

    -- Centre sigil: faint ring + slowly turning rune (under the floor details)
    local ring = fx_make(W / 2, H / 2, -0.6, data.ART.particle.circle, 1, 1, 1, 0.10, 6.0)
    table.insert(self.accent_urls, { url = msg.url(nil, ring, "sprite"), a = 0.10 })
    local rune = fx_make(W / 2, H / 2, -0.59, FX.rune, 1, 1, 1, 0.08, 3.4)
    table.insert(self.accent_urls, { url = msg.url(nil, rune, "sprite"), a = 0.08 })
    go.animate(rune, "euler.z", go.PLAYBACK_LOOP_FORWARD, 360, go.EASING_LINEAR, 120)

    -- Drifting motes
    self.motes = {}
    for _ = 1, 28 do
        local x, y = math.random(0, W), math.random(0, H)
        local id = fx_make(x, y, 0.08, FX.glow, 1, 1, 1, 0.2, 0.08 + math.random() * 0.12)
        table.insert(self.motes, {
            id = id, url = msg.url(nil, id, "sprite"), x = x, y = y,
            vy = 8 + math.random() * 18, phase = math.random() * 6.28,
        })
    end

    -- Vignette (dark edges) drawn over the world, under the GUI
    local v = factory.create("#visual_factory", vmath.vector3(W / 2, H / 2, 0.9))
    sprite.play_flipbook(msg.url(nil, v, "sprite"), hash("vignette"))
    go.set_scale(vmath.vector3(W / 256, H / 256, 1), v)
end

local function update_environment(self, dt)
    local acc = self.accent or { 0.6, 0.45, 1.0 }
    local c = self.clock
    for _, t in ipairs(self.torches or {}) do
        go.set(t.url, "tint", vmath.vector4(1.0, 0.65, 0.25, 0.30 + 0.10 * math.sin(c * 7 + t.phase) + 0.05 * math.sin(c * 13 + t.phase)))
    end
    for _, m in ipairs(self.motes or {}) do
        m.y = m.y + m.vy * dt
        m.x = m.x + math.cos(c * 0.5 + m.phase) * 10 * dt
        if m.y > ARENA_H + 10 then m.y = -10; m.x = math.random(0, ARENA_W) end
        go.set_position(vmath.vector3(m.x, m.y, 0.08), m.id)
        local tw = 0.12 + 0.12 * (0.5 + 0.5 * math.sin(c * 1.5 + m.phase))
        go.set(m.url, "tint", vmath.vector4(acc[1] * 0.6 + 0.4, acc[2] * 0.6 + 0.4, acc[3] * 0.6 + 0.4, tw))
    end
end

-- Keep the player's visuals (body, glow, wand tip, reticle) in step with the simulation.
local function sync_player(self)
    local p = self.player_pos
    go.set_position(p, self.player_visual)
    local sc = (self.slot1 and self.slot1.color) or { r = 1, g = 1, b = 1 }
    local dashing = (self.dash_cd or 0) > 0
    go.set_position(vmath.vector3(p.x, p.y, 0.05), self.player_glow)
    go.set(msg.url(nil, self.player_glow, "sprite"), "tint",
        vmath.vector4(sc.r, sc.g, sc.b, dashing and 0.35 or 0.65))
    local dx, dy = self.aim.x - p.x, self.aim.y - p.y
    local d = math.sqrt(dx * dx + dy * dy)
    if d < 1 then d = 1 end
    go.set_position(vmath.vector3(p.x + dx / d * 20, p.y + dy / d * 20, 0.15), self.wand)
    go.set(msg.url(nil, self.wand, "sprite"), "tint", vmath.vector4(sc.r, sc.g, sc.b, 0.95))
    go.set_position(vmath.vector3(self.aim.x, self.aim.y, 0.2), self.reticle)
    if self.player_art then
        local face = ((self.aim.x < p.x) and -1 or 1) * (self.player_face_sign or 1)
        local a = anim_mod.player({
            moving = self.player_moving,
            dash = (self.dash_t or 0) > 0,
            dx = self.dash_dx, dy = self.dash_dy,
            lean = dx / d,
        }, self.clock)
        local base = self.player_scale
        -- Mirroring must go through sprite.set_hflip: go.set_scale rejects
        -- components <= 0 (AGENTS.md item 40).
        local mirror = face < 0
        if self.player_mirror ~= mirror then
            self.player_mirror = mirror
            sprite.set_hflip(msg.url(nil, self.player_visual, "sprite"), mirror)
        end
        go.set_scale(vmath.vector3(base * a.sx, base * a.sy, 1), self.player_visual)
        go.set_rotation(vmath.quat_rotation_z(a.rot * (mirror and -1 or 1)), self.player_visual)
        go.set_position(vmath.vector3(p.x + a.ox, p.y + a.oy, 0), self.player_visual)
    end
    local a = 1
    if self.player.invuln > 0 and math.sin(self.clock * 50) > 0 then a = 0.35 end
    go.set(msg.url(nil, self.player_visual, "sprite"), "tint", vmath.vector4(1, 1, 1, a))
end

-- Spawn a small short-lived puddle (used by the "leaves a trail" quirk).
local function spawn_trail_puddle(self, x, y, power, color)
    local tp = combat_mod.new_puddle(x, y, 20, 1.0, power * 0.5, {})
    local tvis = fx_make(x, y, 0.05, FX.glow, color.r, color.g, color.b, 0.55, 0.4)
    tp.vis = tvis
    table.insert(self.puddles, tp)
end

function init(self)
    msg.post(".", "acquire_input_focus")

    -- Listeners belong to one init; a hot reload must not double-register them.
    events.clear()
    events.on("hit", on_hit_audio)
    events.on("status", on_status_audio)
    events.on("quirk", on_quirk_audio)
    events.on("player_hit", on_player_hit_audio)
    events.on("dash", on_dash_audio)
    events.on("enemy_spawn", on_enemy_spawn_audio)
    events.on("kill", on_kill_audio)
    events.on("room_clear", on_room_clear_audio)

    -- Audio backend. Everything routes through src/core/sfx.lua; no direct sound.play elsewhere.
    -- `sound` is absent in the headless mock with audio disabled, so guard it.
    if sound then
        sfx.backend = function(id, props) sound.play("/sfx#" .. id, props) end
        sfx.stop_backend = function(id) sound.stop("/sfx#" .. id) end
        sfx.gain_backend = function(id, gain) sound.set_gain("/sfx#" .. id, gain) end
    end
    sfx.reset()
    -- Music shares the same sfx backend (sound components at /sfx#<id>).
    music.reset()
    self.sfx_debug_index = 1

    local ok = selfcheck.run()
    if not ok then
        print("SELFCHECK FAILED - fix hash/RNG/skillgen before continuing")
    end

    -- Arena: stone floor, frame, torches, sigil, motes, vignette (world (0,0) is bottom-left).
    -- Set the fields update/on_input rely on BEFORE anything that can fail, so a
    -- problem while building the arena can never leave the script half-initialised.
    self.aim = vmath.vector3(ARENA_W * 0.5, ARENA_H * 0.5, 0)
    self.particles = {}
    self.anims = {}
    build_environment(self)
    local lv0 = set_room_visuals(self, 1)
    self.player_glow = fx_make(ARENA_W * 0.5, ARENA_H * 0.5, 0.05, FX.glow, 1, 1, 1, 0.6, 1.1)
    self.player_visual = factory.create("#visual_factory", vmath.vector3(ARENA_W * 0.5, ARENA_H * 0.5, 0))
    local pactor = art_mod.actor("player")
    self.player_art = pactor ~= nil
    self.player_scale = pactor and (pactor.scale or 3) or 0.38
    self.player_face_sign = (pactor and pactor.faces == "left") and -1 or 1
    go.set_scale(vmath.vector3(self.player_scale, self.player_scale, 1), self.player_visual)
    go.set(msg.url(nil, self.player_visual, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
    sprite.play_flipbook(msg.url(nil, self.player_visual, "sprite"), hash(pactor and pactor.anim or FX.core))
    self.player_mirror = self.player_art and (self.player_face_sign < 0) or false
    if self.player_art then
        sprite.set_hflip(msg.url(nil, self.player_visual, "sprite"), self.player_mirror)
    end
    self.wand = fx_make(ARENA_W * 0.5 + 20, ARENA_H * 0.5, 0.15, FX.glow, 1, 1, 1, 0.9, 0.3)
    self.reticle = fx_make(ARENA_W * 0.5, ARENA_H * 0.5, 0.2, data.ART.particle.circle, 1, 1, 1, 0.75, 0.4)
    self.dash_t, self.dash_cd, self.dash_dx, self.dash_dy = 0, 0, 0, 0
    self.player_moving = false
    self.hold1, self.hold2 = false, false
    self.low_hp = false        -- heartbeat loop state (pl_lowhp)
    self.cauldron_loop = false -- ui_cauldron_loop state

    -- Player state
    self.player = player_mod.new()
    self.player_pos = vmath.vector3(lv0.start.x, lv0.start.y, 0)

    -- Aim point (mouse)
    self.aim = vmath.vector3(ARENA_W * 0.5, ARENA_H * 0.5, 0)

    -- Movement keys
    self.keys = { up = false, left = false, down = false, right = false }

    -- Debug skill setup (slot 1 and slot 2)
    self.slot1_elem_a = "fire"
    self.slot1_elem_b = "fire"
    self.slot1_shape = "projectile"
    self.slot2_elem_a = "water"
    self.slot2_elem_b = "water"
    self.slot2_shape = "projectile"

    self.slot1 = skillgen.makeSkill("fire", "fire", "projectile")
    self.slot2 = skillgen.makeSkill("water", "water", "projectile")
    self.slot1_cooldown = 0
    self.slot2_cooldown = 0

    -- Cooldowns belong to the SKILL, not the slot: when a slot is swapped the
    -- remaining time is remembered per skill key and restored on swap-back.
    -- Stored as an absolute "ready at" time on self.clock.
    self.clock = 0
    self.cooldown_ready = { [1] = {}, [2] = {} }

    print("Slot 1: " .. self.slot1.compound .. " " .. self.slot1.shape .. " (power=" .. self.slot1.power .. ", quirk=" .. self.slot1.quirk .. ")")
    print("Slot 2: " .. self.slot2.compound .. " " .. self.slot2.shape .. " (power=" .. self.slot2.power .. ", quirk=" .. self.slot2.quirk .. ")")

    -- Enemies and active deliveries
    self.enemies = {}
    self.enemy_bolts = {}
    self.bolts = {}
    self.particles = {}
    self.anims = {}
    self.screen_flash = 0
    self.puddles = {}
    self.orbits = {}
    self.cones = {}
    self.bursts = {}
    self.spawn_timer = 0

    -- Repeat casts (quirk: repeats once) -> { slot = 1|2, time = when to fire }
    self.repeat_casts = {}

    -- M4: run start picks + full cooldown length (after quirk scaling) for the HUD bars
    self.picks = {}
    self.slot1_cd_max = self.slot1.cooldown
    self.slot2_cd_max = self.slot2.cooldown

    -- M5: inventory, room progression, telegraphs, rewards, cauldron
    self.room_number = 0
    self.inventory = {
        elements = { fire = 0, water = 0, wind = 0, earth = 0 },
        shapes = { projectile = 0, puddle = 0, orbit = 0, cone = 0, burst = 0 },
    }
    self.telegraphs = {}
    self.reward_options = nil
    self.room_clear_timer = nil
    self.cauldron = { ea = "fire", eb = "water", shape = "projectile" }
    if self.cauldron_loop then
        sfx.stop("ui_cauldron_loop")
        self.cauldron_loop = false
    end
    self.spawned_count = 0
    self.room_budget = 0

    self.state = "TITLE"
    sfx.play("state_title")
    music.set_state("TITLE")
    print("Game initialized. State: " .. self.state)
end

-- Rebuild both slot skills from current debug element/shape picks.
-- Remaining cooldown travels with the skill, never with the slot:
-- swapping away saves it, swapping back restores it (no reset exploit,
-- no inheriting the other skill's timer).
local function rebuild_skills(self)
    if self.slot1_cooldown > 0 then
        self.cooldown_ready[1][self.slot1.key] = self.clock + self.slot1_cooldown
    end
    if self.slot2_cooldown > 0 then
        self.cooldown_ready[2][self.slot2.key] = self.clock + self.slot2_cooldown
    end

    self.slot1 = skillgen.makeSkill(self.slot1_elem_a, self.slot1_elem_b, self.slot1_shape)
    self.slot2 = skillgen.makeSkill(self.slot2_elem_a, self.slot2_elem_b, self.slot2_shape)

    local function remaining(slot, skill)
        local ready = self.cooldown_ready[slot][skill.key]
        if not ready then return 0 end
        local r = ready - self.clock
        if r < 0 then
            self.cooldown_ready[slot][skill.key] = nil
            return 0
        end
        return r
    end
    self.slot1_cooldown = remaining(1, self.slot1)
    self.slot2_cooldown = remaining(2, self.slot2)
    self.slot1_cd_max = self.slot1.cooldown
    self.slot2_cd_max = self.slot2.cooldown

    print("Slot 1: " .. self.slot1.compound .. " " .. self.slot1.shape .. " (power=" .. self.slot1.power .. ", quirk=" .. self.slot1.quirk .. ")")
    print("Slot 2: " .. self.slot2.compound .. " " .. self.slot2.shape .. " (power=" .. self.slot2.power .. ", quirk=" .. self.slot2.quirk .. ")")
end

-- All 10 compound pairs (elements sorted, doubles allowed) in canonical order.
local COMPOUND_PAIRS = {
    { "earth", "earth" }, { "earth", "fire" }, { "earth", "water" }, { "earth", "wind" },
    { "fire", "fire" },   { "fire", "water" }, { "fire", "wind" },
    { "water", "water" }, { "water", "wind" }, { "wind", "wind" },
}

-- Debug: cycle slot `which` (1 or 2) through all 10 compounds.
local function cycle_compound(self, which)
    local a, b
    if which == 1 then
        a, b = self.slot1_elem_a, self.slot1_elem_b
    else
        a, b = self.slot2_elem_a, self.slot2_elem_b
    end
    local idx = 0
    for i, pair in ipairs(COMPOUND_PAIRS) do
        if pair[1] == a and pair[2] == b then idx = i end
    end
    idx = idx % #COMPOUND_PAIRS + 1
    local pair = COMPOUND_PAIRS[idx]
    if which == 1 then
        self.slot1_elem_a, self.slot1_elem_b = pair[1], pair[2]
    else
        self.slot2_elem_a, self.slot2_elem_b = pair[1], pair[2]
    end
    rebuild_skills(self)
end

-- ===== M4: UI plumbing =====================================================
-- The HUD draws and hit-tests; every rule below lives in the game script.

local function skill_view(skill, cd, cd_max, ea, eb)
    if not skill then return nil end
    return {
        name = skill.compound .. " " .. (SHAPE_DISPLAY[skill.shape] or skill.shape),
        quirk = skill.quirk,
        power = skill.power,
        cd = cd or 0,
        cd_max = cd_max or skill.cooldown,
        ea = ea,
        eb = eb,
    }
end

local function send_ui(self)
    local preview = nil
    if self.state == "CAULDRON" then
        local ok = (self.inventory.elements[self.cauldron.ea] or 0) > 0
            and (self.inventory.elements[self.cauldron.eb] or 0) > 0
            and (self.inventory.shapes[self.cauldron.shape] or 0) > 0
        if ok then
            local sk = skillgen.makeSkill(self.cauldron.ea, self.cauldron.eb, self.cauldron.shape)
            preview = {
                name = sk.compound .. " " .. (SHAPE_DISPLAY[sk.shape] or sk.shape),
                quirk = sk.quirk,
                power = sk.power,
            }
        end
    end
    msg.post("/hud#gui", "ui", {
        state = self.state,
        hp = self.player.hp,
        max_hp = self.player.max_hp,
        picks = self.picks,
        credits = credits_lines,
        room = self.room_number,
        inventory = self.inventory,
        reward_options = self.reward_options,
        cauldron = self.cauldron,
        preview = preview,
        boss = (self.boss ~= nil),
        boss_hp = (self.boss and self.boss.hp) or 0,
        boss_max_hp = (self.boss and self.boss.max_hp) or 0,
        flash = self.screen_flash or 0,
        s1 = skill_view(self.slot1, self.slot1_cooldown, self.slot1_cd_max,
                        self.slot1_elem_a, self.slot1_elem_b),
        s2 = skill_view(self.slot2, self.slot2_cooldown, self.slot2_cd_max,
                        self.slot2_elem_a, self.slot2_elem_b),
    })
end

-- Delete every live visual exactly once (AGENTS.md item 6), then forget it.
local function clear_world(self)
    self.world_id = (self.world_id or 0) + 1
    for _, p in ipairs(self.bolts) do
        del_bolt(p)
    end
    for _, p in ipairs(self.puddles) do
        if p.vis then go.delete(p.vis) end
        if p.ring then go.delete(p.ring) end
    end
    for _, o in ipairs(self.orbits) do
        for _, v in ipairs(o.vis or {}) do go.delete(v) end
        for _, v in ipairs(o.glow or {}) do go.delete(v) end
        for _, v in ipairs(o.flame or {}) do go.delete(v) end
    end
    for _, c in ipairs(self.cones) do
        if c.vis then go.delete(c.vis) end
    end
    for _, b in ipairs(self.enemy_bolts or {}) do
        if b.id then go.delete(b.id) end
    end
    self.enemy_bolts = {}
    for _, e in ipairs(self.enemies) do
        if e.id then go.delete(e.id) end
        e.telegraph_ring = nil              -- the ring is owned (and deleted) by self.telegraphs below
    end
    for _, t in ipairs(self.telegraphs or {}) do
        if t.ring then go.delete(t.ring); t.ring = nil end
    end
    for _, b in ipairs(self.bursts) do
        if b.vis then go.delete(b.vis) end
    end
    self.bolts = {}
    self.puddles = {}
    self.orbits = {}
    self.cones = {}
    self.bursts = {}
    self.enemies = {}
    self.telegraphs = {}
    self.boss = nil
    for _, p in ipairs(self.particles or {}) do
        if p.id then go.delete(p.id) end
    end
    self.particles = {}
    for _, a in ipairs(self.anims or {}) do
        if a.id then go.delete(a.id) end
    end
    self.anims = {}
    self.repeat_casts = {}
    sfx.stop("loop_pool")
    sfx.stop("loop_orbit")
end

local function reset_run(self)
    clear_world(self)
    self.player = player_mod.new()
    local lv1 = set_room_visuals(self, 1)
    self.player_pos = vmath.vector3(lv1.start.x, lv1.start.y, 0)
    go.set_position(self.player_pos, self.player_visual)
    self.picks = {}
    self.slot1_cooldown = 0
    self.slot2_cooldown = 0
    self.cooldown_ready = { [1] = {}, [2] = {} }
    self.spawn_timer = 0
    self.room_number = 0
    self.inventory = {
        elements = { fire = 0, water = 0, wind = 0, earth = 0 },
        shapes = { projectile = 0, puddle = 0, orbit = 0, cone = 0, burst = 0 },
    }
    self.telegraphs = {}
    self.reward_options = nil
    self.room_clear_timer = nil
    self.cauldron = { ea = "fire", eb = "water", shape = "projectile" }
    if self.cauldron_loop then
        sfx.stop("ui_cauldron_loop")
        self.cauldron_loop = false
    end
    self.spawned_count = 0
    self.room_budget = 0
    self.boss = nil
    self.screen_flash = 0
    self.dash_t, self.dash_cd = 0, 0
    self.hold1, self.hold2 = false, false
    self.pending_wave = {}
    self.state = "TITLE"
    sfx.play("state_title")
    music.set_state("TITLE")
    print("State: TITLE")
end

local function fire_enemy_bolt(self, x, y, tx, ty, speed, damage)
    local dx = tx - x
    local dy = ty - y
    local d = math.sqrt(dx * dx + dy * dy)
    if d < 0.001 then return end
    dx = dx / d; dy = dy / d
    local b = {
        x = x, y = y,
        vx = dx * (speed or 200),
        vy = dy * (speed or 200),
        life = 3.0,
        damage = damage or 6,
        id = factory.create("#visual_factory", vmath.vector3(x, y, 0)),
    }
    go.set_scale(vmath.vector3(0.15, 0.15, 1), b.id)
    go.set(msg.url(nil, b.id, "sprite"), "tint", vmath.vector4(1.0, 0.4, 0.4, 1.0))
    sprite.play_flipbook(msg.url(nil, b.id, "sprite"), hash(FX.core))
    table.insert(self.enemy_bolts, b)
end

local function spawn_wisp_at(self, x, y)
    local e = enemies_mod.spawn("wisp", self.player_pos, ARENA_W, ARENA_H)
    e.x = math.max(MARGIN, math.min(ARENA_W - MARGIN, x))
    e.y = math.max(MARGIN, math.min(ARENA_H - MARGIN, y))
    local t = enemies_mod.ENEMY_TYPES.wisp
    local vis = factory.create("#visual_factory", vmath.vector3(e.x, e.y, 0))
    local actor = art_mod.actor("wisp")
    local es = actor and (actor.scale or 3) or (t.radius / 21.3)
    local bt = actor and { r = 1, g = 1, b = 1 } or { r = t.color.r, g = t.color.g, b = t.color.b }
    go.set_scale(vmath.vector3(es, es, 1), vis)
    go.set(msg.url(nil, vis, "sprite"), "tint", vmath.vector4(bt.r, bt.g, bt.b, 1))
    sprite.play_flipbook(msg.url(nil, vis, "sprite"), hash(actor and actor.anim or "circle"))
    e.base_scale, e.base_tint = es, bt
    e.art = actor ~= nil
    e.face_sign = (actor and actor.faces == "left") and -1 or 1
    e.mirror = (e.face_sign or 1) < 0
    if e.art then sprite.set_hflip(msg.url(nil, vis, "sprite"), e.mirror) end
    -- Cosmetic phase from the spawn position: deterministic, and it must not consume
    -- math.random (that would shift room composition / AI decisions).
    e.anim_phase = (e.x * 0.07 + e.y * 0.11) % 6.28
    e.id = vis
    e.vx = 0; e.vy = 0
    e.telegraph = 0
    e.active = true
    table.insert(self.enemies, e)
    events.emit("enemy_spawn", { self = self, enemy = e })
end

local function is_boss_room(room) return room > data.TUNING.ROOM_COUNT end
-- M5: also sets up the room budget + telegraphed spawns.
-- Move an enemy towards (nx, ny), sliding along walls.
local function move_enemy(self, e, nx, ny)
    e.x, e.y = level_mod.slide(self.level, e.x, e.y, nx, ny, e.radius * 0.85)
end

-- Apply code-driven animation (src/game/anim.lua) to an enemy's sprite.
-- Collision and AI keep using e.x / e.y; only the sprite moves, scales and rotates.
local function sync_enemy_visual(self, e, dt)
    if not e.id then return end

    -- How far the body moved since the last visual sync (drives the run cycle).
    local moved = 0
    if e.anim_x then
        local dx, dy = e.x - e.anim_x, e.y - e.anim_y
        moved = math.sqrt(dx * dx + dy * dy)
    end
    e.anim_x, e.anim_y = e.x, e.y

    -- Slinger recoil is a short timer started when it fires.
    if (e.recoil or 0) > 0 then e.recoil = math.max(0, e.recoil - (dt or 0)) end

    if not e.art then
        go.set_position(vmath.vector3(e.x, e.y, 0), e.id)
        return
    end

    local a = anim_mod.enemy(e.type, {
        moving = moved > 0.4,
        charging = e.charging,
        windup = (e.windup or 0) > 0
            or (e.type == "boss" and (e.pattern_timer or 9) < 0.5),
        stunned = status_mod.has(e, "stun"),
        fire = (e.recoil or 0) > 0,
        retreat = e.retreating and not status_mod.has(e, "stun"),
    }, self.clock + (e.anim_phase or 0))

    -- The hit flash used to set the scale to base * 1.25; keep that pop by folding
    -- it into the animated scale instead of fighting over go.set_scale.
    local base = (e.base_scale or 1) * (((e.flash_timer or 0) > 0) and 1.18 or 1)
    local face = ((self.player_pos.x >= e.x) and 1 or -1) * (e.face_sign or 1)
    -- Flip with sprite.set_hflip, never a negative scale component (AGENTS.md item 40).
    local mirror = face < 0
    if e.mirror ~= mirror then
        e.mirror = mirror
        sprite.set_hflip(msg.url(nil, e.id, "sprite"), mirror)
    end
    go.set_scale(vmath.vector3(base * a.sx, base * a.sy, 1), e.id)
    go.set_rotation(vmath.quat_rotation_z(a.rot * (mirror and -1 or 1)), e.id)
    go.set_position(vmath.vector3(e.x + a.ox, e.y + a.oy, 0), e.id)
end

local function spawn_telegraphed_wisp(self, etype, x, y)
    etype = etype or "wisp"
    local e = enemies_mod.spawn(etype, self.player_pos, ARENA_W, ARENA_H)
    if x then e.x, e.y = x, y end            -- authored spawn point from the room layout
    local vis = factory.create("#visual_factory", vmath.vector3(e.x, e.y, 0))
    local t = enemies_mod.ENEMY_TYPES[etype] or enemies_mod.ENEMY_TYPES.wisp
    local actor = art_mod.actor(etype)
    local es
    if actor then
        es = actor.scale or 3
        e.base_tint = { r = 1, g = 1, b = 1 }
        go.set(msg.url(nil, vis, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
        sprite.play_flipbook(msg.url(nil, vis, "sprite"), hash(actor.anim))
    else
        es = (t.shape == "square") and (t.radius / 26) or (t.radius / 21.3)
        e.base_tint = { r = t.color.r, g = t.color.g, b = t.color.b }
        if t.rot then go.set_rotation(vmath.quat_rotation_z(math.rad(t.rot)), vis) end
        go.set(msg.url(nil, vis, "sprite"), "tint", vmath.vector4(t.color.r, t.color.g, t.color.b, 1))
        sprite.play_flipbook(msg.url(nil, vis, "sprite"), hash(t.shape or "circle"))
    end
    e.base_scale = es
    e.art = actor ~= nil
    e.face_sign = (actor and actor.faces == "left") and -1 or 1
    e.mirror = (e.face_sign or 1) < 0
    if e.art then sprite.set_hflip(msg.url(nil, vis, "sprite"), e.mirror) end
    e.anim_phase = (e.x * 0.07 + e.y * 0.11) % 6.28
    go.set_scale(vmath.vector3(es, es, 1), vis)
    e.id = vis
    e.vx = 0
    e.vy = 0
    e.telegraph = (etype == "boss") and 1.5 or (0.5)
    e.active = false
    local rs = (etype == "boss") and 1.6 or 0.9
    local ring = fx_make(e.x, e.y, 0.1, data.ART.particle.circle, 1.0, 0.35, 0.25, 0.9, rs)
    e.telegraph_ring = ring
    table.insert(self.enemies, e)
    table.insert(self.telegraphs, { ring = ring, enemy = e })
    -- boss tracking
    if etype == "boss" then self.boss = e end
end

local ENEMY_COST = { wisp = 1, slinger = 2, charger = 3, splitter = 3, brute = 4 }
local ENEMY_UNLOCK = { { "wisp", 1 }, { "slinger", 2 }, { "charger", 3 }, { "splitter", 4 }, { "brute", 5 } }

-- Room n (1..ROOM_COUNT) spends a budget of 3 + 2n points; the boss is the last room.
local function room_composition(room)
    if room > data.TUNING.ROOM_COUNT then return { "boss" } end
    local budget = 3 + 2 * room
    local pool = {}
    for _, u in ipairs(ENEMY_UNLOCK) do
        if room >= u[2] then table.insert(pool, u[1]) end
    end
    local list = {}
    local newest = pool[#pool]
    if room > 1 and newest ~= "wisp" then
        table.insert(list, newest)           -- always show off the newest enemy type
        budget = budget - ENEMY_COST[newest]
    end
    while budget > 0 and #list < 14 do
        local pick = pool[math.random(#pool)]
        if ENEMY_COST[pick] > budget then pick = "wisp" end
        table.insert(list, pick)
        budget = budget - ENEMY_COST[pick]
    end
    return list
end

local function enter_room(self)
    if self.state == "PICK_START" then
        if #self.picks < 2 then return end
        self.slot1_elem_a = self.picks[1]
        self.slot1_elem_b = self.picks[2]
        self.slot1_shape = "projectile"
        self.slot1 = skillgen.makeSkill(self.slot1_elem_a, self.slot1_elem_b, "projectile")
        self.slot1_cooldown = 0
        self.slot1_cd_max = self.slot1.cooldown
        self.cooldown_ready[1] = {}
        -- grant starting ingredients
        self.inventory.elements[self.picks[1]] = self.inventory.elements[self.picks[1]] + 1
        self.inventory.elements[self.picks[2]] = self.inventory.elements[self.picks[2]] + 1
        self.inventory.shapes.projectile = self.inventory.shapes.projectile + 1
        print("State: ROOM -- " .. self.slot1.compound .. " " .. self.slot1.shape ..
              " (power=" .. self.slot1.power .. ", quirk=" .. self.slot1.quirk .. ")")
    elseif self.state == "CAULDRON" then
        -- next room: keep current skills/inventory
    else
        -- direct (debug) entry
    end

    clear_world(self)
    self.room_number = self.room_number + 1
    self.room_clear_timer = nil
    local lv = set_room_visuals(self, self.room_number)     -- tiles + palette for this room
    self.player_pos.x, self.player_pos.y = lv.start.x, lv.start.y
    go.set_position(self.player_pos, self.player_visual)
    self.dash_t = 0

    -- Authored enemies from the layout: lowercase = wave 1, uppercase = wave 2
    local wave1, wave2 = {}, {}
    for _, sp in ipairs(lv.spawns) do
        if sp.wave == 2 then table.insert(wave2, sp) else table.insert(wave1, sp) end
    end
    if #lv.spawns == 0 then
        -- fallback for rooms without markers: budgeted random composition on free cells
        for _, etype in ipairs(room_composition(self.room_number)) do
            local cell
            for _ = 1, 20 do
                cell = lv.free_cells[math.random(#lv.free_cells)]
                local ddx, ddy = cell.x - lv.start.x, cell.y - lv.start.y
                if ddx * ddx + ddy * ddy > 200 * 200 then break end
            end
            table.insert(wave1, { type = etype, x = cell.x, y = cell.y })
        end
    end
    self.pending_wave = wave2
    self.room_budget = #wave1 + #wave2
    self.spawned_count = #wave1 + #wave2
    self.boss = nil
    for i, sp in ipairs(wave1) do
        spawn_telegraphed_wisp(self, sp.type, sp.x, sp.y)
        local e = self.enemies[#self.enemies]
        e.telegraph = (sp.type == "boss") and 1.5 or (0.5 + (i - 1) * 0.15)
    end

    self.spawn_timer = 0
    self.state = "ROOM"
    local intensity = 0
    local alive_n = 0
    for _, e in ipairs(self.enemies or {}) do if e.alive then alive_n = alive_n + 1 end end
    intensity = math.min(1, alive_n / 8)
    if self.room_number > data.TUNING.ROOM_COUNT then
        music.set_state("BOSS")
    else
        music.set_state("ROOM", { intensity = intensity })
    end
    print("Room " .. self.room_number .. " (" .. (lv.name or "?") .. ", " .. self.room_budget .. " enemies)")
end

-- DEBUG tool (TUNING.DEBUG): jump into the Training Arena (immortal, harmless dummies)
-- for practicing skills; press T again while inside to return to the title screen.
local TRAINING_ROOM = #rooms_mod    -- the last room in rooms.lua
local function toggle_training_room(self)
    if self.room_number == TRAINING_ROOM then
        reset_run(self)
    else
        self.room_number = TRAINING_ROOM - 1
        enter_room(self)        -- enter_room increments room_number -> TRAINING_ROOM
    end
end

-- M5 helpers: rewards, cauldron crafting, inventory cycling.
local function owned_elements(self)
    local out = {}
    for _, el in ipairs(ELEMENT_LIST) do
        if (self.inventory.elements[el] or 0) > 0 then table.insert(out, el) end
    end
    return out
end

local function owned_shapes(self)
    local out = {}
    for _, sh in ipairs(SHAPE_LIST) do
        if (self.inventory.shapes[sh] or 0) > 0 then table.insert(out, sh) end
    end
    return out
end

local function generate_rewards(self)
    local pool = {}
    for _, el in ipairs(ELEMENT_LIST) do table.insert(pool, { kind = "element", id = el }) end
    for _, sh in ipairs(SHAPE_LIST) do table.insert(pool, { kind = "shape", id = sh }) end
    for i = #pool, 2, -1 do
        local j = math.random(i)
        pool[i], pool[j] = pool[j], pool[i]
    end
    local opts, used = {}, {}
    for _, p in ipairs(pool) do
        local key = p.kind .. ":" .. p.id
        if not used[key] and #opts < 3 then
            used[key] = true
            table.insert(opts, p)
        end
    end
    return opts
end

local function craft_skill(self, slot, ea, eb, shape)
    if (self.inventory.elements[ea] or 0) < 1
       or (self.inventory.elements[eb] or 0) < 1
       or (self.inventory.shapes[shape] or 0) < 1 then
        print("Not enough ingredients")
        sfx.play("ui_craft_bad")
        return false
    end
    self.inventory.elements[ea] = self.inventory.elements[ea] - 1
    self.inventory.elements[eb] = self.inventory.elements[eb] - 1
    self.inventory.shapes[shape] = self.inventory.shapes[shape] - 1
    local skill = skillgen.makeSkill(ea, eb, shape)
    if slot == 1 then
        self.slot1_elem_a = ea; self.slot1_elem_b = eb; self.slot1_shape = shape
        self.slot1 = skill; self.slot1_cooldown = 0; self.slot1_cd_max = skill.cooldown
        self.cooldown_ready[1] = {}
    else
        self.slot2_elem_a = ea; self.slot2_elem_b = eb; self.slot2_shape = shape
        self.slot2 = skill; self.slot2_cooldown = 0; self.slot2_cd_max = skill.cooldown
        self.cooldown_ready[2] = {}
    end
    print("Crafted " .. skill.compound .. " " .. skill.shape .. " -> Slot " .. slot)
    sfx.play("ui_craft")
    local compound = tostring(skill.compound or ""):lower():gsub("%s+", "_")
    if compound ~= "" then
        sfx.play("sig_" .. compound, { gain = 0.9 })
    end
    return true
end

local function cauldron_cycle(self, field)
    if field == "ea" or field == "eb" then
        local owned = owned_elements(self)
        if #owned == 0 then return end
        local cur = self.cauldron[field]
        local idx = 1
        for i, el in ipairs(owned) do if el == cur then idx = i break end end
        idx = idx + 1
        if idx > #owned then idx = 1 end
        self.cauldron[field] = owned[idx]
    elseif field == "shape" then
        local owned = owned_shapes(self)
        if #owned == 0 then return end
        local cur = self.cauldron.shape
        local idx = 1
        for i, sh in ipairs(owned) do if sh == cur then idx = i break end end
        idx = idx + 1
        if idx > #owned then idx = 1 end
        self.cauldron.shape = owned[idx]
    end
end

local function handle_ui_action(self, msg)
    local action = msg and msg.action
    if action == "start" then
        if self.state == "TITLE" then
            self.picks = {}
            self.state = "PICK_START"
            print("State: PICK_START")
        end
    elseif action == "credits" then
        if self.state == "TITLE" then
            self.state = "CREDITS"
            print("State: CREDITS")
        end
    elseif action == "back" then
        if self.state == "CREDITS" then
            self.state = "TITLE"
            sfx.play("state_title")
            music.set_state("TITLE")
            print("State: TITLE")
        end
    elseif action == "pick" then
        if self.state == "PICK_START" and msg.element and #self.picks < 2 then
            table.insert(self.picks, msg.element)
            print("Picked " .. msg.element .. " (" .. #self.picks .. "/2)")
            sfx.play("ui_pick")
        end
    elseif action == "enter" then
        if self.state == "PICK_START" then
            enter_room(self)
            sfx.play("ui_click")
        end
    elseif action == "reward_pick" then
        if self.state == "REWARD" and type(msg.index) == "number" then
            local opt = self.reward_options and self.reward_options[msg.index]
            if not opt and self.reward_options then
                -- Fallback: pick the first available option
                for i = 1, 3 do
                    if self.reward_options[i] then
                        opt = self.reward_options[i]
                        msg.index = i
                        break
                    end
                end
            end
            if opt then
                if opt.kind == "element" then
                    self.inventory.elements[opt.id] = self.inventory.elements[opt.id] + 1
                else
                    self.inventory.shapes[opt.id] = self.inventory.shapes[opt.id] + 1
                end
                print("Reward: " .. opt.kind .. " " .. opt.id)
                sfx.play("ui_card")
                local oe = owned_elements(self)
                local os_ = owned_shapes(self)
                if #oe > 0 then self.cauldron.ea = oe[1] end
                if #oe >= 2 then self.cauldron.eb = oe[2] elseif #oe == 1 then self.cauldron.eb = oe[1] end
                if #os_ > 0 then self.cauldron.shape = os_[1] end
                self.state = "CAULDRON"
                sfx.play("ui_cauldron_loop", { gain = 0.45 })
                self.cauldron_loop = true
                music.set_state("CAULDRON")
                print("State: CAULDRON")
            end
        end
    elseif action == "cauldron_cycle" then
        if self.state == "CAULDRON" and msg.field then
            cauldron_cycle(self, msg.field)
            sfx.play("ui_hover")
        end
    elseif action == "craft" then
        if self.state == "CAULDRON" then
            local slot = msg.slot or 1
            craft_skill(self, slot, self.cauldron.ea, self.cauldron.eb, self.cauldron.shape)
        end
    elseif action == "done" then
        if self.state == "CAULDRON" then
            if self.cauldron_loop then
                sfx.stop("ui_cauldron_loop")
                self.cauldron_loop = false
            end
            enter_room(self)
        end
    elseif action == "continue" then
        if self.state == "DEAD" or self.state == "WIN" then reset_run(self) end
    end
end

-- Forward declaration: defined at the bottom, but used by update/on_input.
local do_cast

function update(self, dt)
    self.clock = self.clock + dt
    sfx.update(dt)
    music.update(dt)
    -- Reset per-frame reaction counters
    self.reaction_count = 0
    self.aoe_this_frame = false
    -- Pool/orbit sustain loops: one loop per type, gain rises with the active count.
    sfx.loop_set("pool", #(self.puddles or {}))
    sfx.loop_set("orbit", #(self.orbits or {}))
    -- Low-HP heartbeat loop: pl_lowhp while below 30% HP in a room.
    local low = self.state == "ROOM" and self.player and self.player.hp > 0
        and self.player.hp < self.player.max_hp * 0.3
    if low and not self.low_hp then
        sfx.play("pl_lowhp", { gain = 0.5 })
        self.low_hp = true
    elseif not low and self.low_hp then
        sfx.stop("pl_lowhp")
        self.low_hp = false
    end
    -- Music intensity tracks live enemy count in ROOM state.
    if self.state == "ROOM" then
        local alive_n = 0
        for _, e in ipairs(self.enemies or {}) do if e.alive then alive_n = alive_n + 1 end end
        music.set_intensity(math.min(1, alive_n / 8))
    end
    if self.level and self.state == "ROOM" then
        level_mod.update_flow(self.level, self.player_pos.x, self.player_pos.y)
    end
    self.dash_cd = math.max(0, (self.dash_cd or 0) - dt)
    update_environment(self, dt)

    -- Player movement (ROOM only: menus are click-driven, death freezes you)
    local dx = 0
    local dy = 0
    if self.state == "ROOM" then
        if self.keys.right then dx = dx + 1 end
        if self.keys.left  then dx = dx - 1 end
        if self.keys.down  then dy = dy - 1 end
        if self.keys.up    then dy = dy + 1 end
    end

    -- Dash: short burst along dash_dx/dy, invulnerable, leaves afterimages
    if self.dash_t > 0 then
        self.dash_t = self.dash_t - dt
        self.player_pos.x, self.player_pos.y = level_mod.slide(self.level, self.player_pos.x, self.player_pos.y,
            self.player_pos.x + self.dash_dx * data.TUNING.DASH_SPEED * dt,
            self.player_pos.y + self.dash_dy * data.TUNING.DASH_SPEED * dt, PLAYER_RADIUS)
        local sc1 = (self.slot1 and self.slot1.color) or { r = 1, g = 1, b = 1 }
        spawn_particle(self, self.player_pos.x, self.player_pos.y, sc1.r, sc1.g, sc1.b, 0.8, 0.8, 0.25, 0, 0, FX.glow, 0.1)
        dx, dy = 0, 0
    end

    if dx ~= 0 or dy ~= 0 then
        local len = math.sqrt(dx * dx + dy * dy)
        dx = dx / len
        dy = dy / len
        self.player_pos.x, self.player_pos.y = level_mod.slide(self.level, self.player_pos.x, self.player_pos.y,
            self.player_pos.x + dx * data.TUNING.PLAYER_SPEED * dt,
            self.player_pos.y + dy * data.TUNING.PLAYER_SPEED * dt, PLAYER_RADIUS)
        go.set_position(self.player_pos, self.player_visual)
    end

    self.player_moving = (dx ~= 0 or dy ~= 0)
    sync_player(self)

    -- Player invulnerability + player-side statuses (hide_self)
    player_mod.update_invuln(self.player, dt)
    status_mod.update(self.player, dt)

    -- Burn DPS for all enemies
    for _, e in ipairs(self.enemies) do
        if e.alive and e.statuses and e.statuses.burn then
            e.burn_timer = (e.burn_timer or 0) + dt
            while e.burn_timer >= 1.0 do
                e.burn_timer = e.burn_timer - 1.0
                local burn_dmg = 3
                if e.statuses and e.statuses.burn and e.statuses.burn.dps_mul then
                    burn_dmg = math.floor(burn_dmg * e.statuses.burn.dps_mul + 0.5)
                end
                apply_hit(self, e, burn_dmg, nil, {
                    kind = "burn", x = e.x, y = e.y,
                    knockback = false, silent_log = true,
                })
                if not e.alive then break end
            end
        end
    end

    -- spread: a burning enemy ignites nearby enemies (once per frame)
    for _, e in ipairs(self.enemies) do
        if e.alive and e.statuses and e.statuses.spread and e.statuses.burn then
            for _, other in ipairs(self.enemies) do
                if other ~= e and other.alive
                   and not (other.statuses and other.statuses.burn) then
                    local ddx = other.x - e.x
                    local ddy = other.y - e.y
                    local sr = e.spread_radius or 60
                    if (ddx * ddx + ddy * ddy) < (sr * sr) then
                        apply_status(self, other, { "burn" })
                    end
                end
            end
        end
    end

    if self.state == "ROOM" then
        -- Telegraph countdown (enemies are spawned inactive by enter_room)
        for i = #self.telegraphs, 1, -1 do
            local t = self.telegraphs[i]
            local e = t.enemy
            e.telegraph = (e.telegraph or 0) - dt
            if not e.alive then
                -- killed (area attack / burn) before it finished spawning: drop its telegraph
                if t.ring then go.delete(t.ring) end
                t.ring = nil
                e.telegraph_ring = nil
                table.remove(self.telegraphs, i)
            elseif e.telegraph <= 0 then
                e.active = true
                e.telegraph = 0
                if t.ring then go.delete(t.ring) end
                t.ring = nil
                e.telegraph_ring = nil
                table.remove(self.telegraphs, i)
                events.emit("enemy_spawn", { self = self, enemy = e })
            else
                local frac = math.max(0.2, e.telegraph / 0.9)
                if t.ring then go.set_scale(vmath.vector3(0.3 + frac * 0.7, 0.3 + frac * 0.7, 1), t.ring) end
                if e.id then go.set_position(vmath.vector3(e.x, e.y, 0), e.id) end
            end
        end

        -- Update enemies (chase, modified by statuses)
        for i = #self.enemies, 1, -1 do
            local e = self.enemies[i]
            if not e.alive then
                local kc = (enemies_mod.ENEMY_TYPES[e.type] or {}).color or { r = 1, g = 1, b = 1 }
                fx_kill(self, e.x, e.y, kc, e)
                if e.type == "splitter" then
                    spawn_wisp_at(self, e.x - 8, e.y)
                    spawn_wisp_at(self, e.x + 8, e.y)
                end
                if e.id then go.delete(e.id) end
                table.remove(self.enemies, i)
            else
                if not e.active then
                    if e.id then sync_enemy_visual(self, e, dt) end
                else
                    -- Status effects on movement
                local stunned = status_mod.has(e, "stun")
                local rooted = status_mod.has(e, "root")
                local blinded = status_mod.has(e, "blind") or status_mod.has(self.player, "hide_self")
                local slowed = status_mod.has(e, "slow")

                -- Visual status tint (only touch the sprite when it changes)
                if (e.flash_timer or 0) > 0 then
                    e.flash_timer = e.flash_timer - dt
                    e.tint_name = "__flash"
                    go.set(msg.url(nil, e.id, "sprite"), "tint", vmath.vector4(1, 1, 1, 1))
                    if e.base_scale then
                        local pop = e.base_scale * 1.25
                        go.set_scale(vmath.vector3(pop, pop, 1), e.id)
                    end
                elseif (e.windup or 0) > 0 then
                    e.tint_name = "__windup"
                    local pulse = 0.5 + 0.5 * math.sin(self.clock * 40)
                    go.set(msg.url(nil, e.id, "sprite"), "tint", vmath.vector4(1, 0.9 * pulse + 0.1, 0.2, 1))
                else
                    local tname, tcol = visible_status_tint(e)
                    if tname ~= e.tint_name then
                        e.tint_name = tname
                        local c = tcol or e.base_tint or (enemies_mod.ENEMY_TYPES[e.type] or {}).color or ENEMY_BASE_TINT
                        if e.base_scale then go.set_scale(vmath.vector3(e.base_scale, e.base_scale, 1), e.id) end
                        go.set(msg.url(nil, e.id, "sprite"), "tint", vmath.vector4(c.r, c.g, c.b, 1))
                    end
                end

                local skip_normal_move = false

                -- Type-specific behavior
                if e.type == "charger" then
                    if stunned then e.charging = false; e.windup = 0 end
                    if e.charging then
                        e.charge_time = (e.charge_time or 0) - dt
                        local ox, oy = e.x, e.y
                        move_enemy(self, e, e.x + (e.charge_vx or 0) * 320 * dt, e.y + (e.charge_vy or 0) * 320 * dt)
                        if e.id then go.set_position(vmath.vector3(e.x, e.y, 0), e.id) end
                        local moved = math.sqrt((e.x - ox) ^ 2 + (e.y - oy) ^ 2)
                        if moved < 320 * dt * 0.3 and (e.charge_time or 0) > 0.05 then
                            -- slammed into a wall: stunned and vulnerable
                            e.charge_time = 0
                            apply_status(self, e, { "stun" })
                            spawn_particle(self, e.x, e.y, 1, 0.9, 0.4, 1, 0.6, 0.35, 0, 0, data.ART.particle.scorch, 1.4)
                            sfx.play("en_wall_stun", { x = e.x })
                        end
                        if (e.charge_time or 0) <= 0 then e.charging = false; e.charge_timer = 2.0 end
                        skip_normal_move = true
                    elseif (e.windup or 0) > 0 then
                        -- telegraph: stand still and pulse, then dash where the player IS now
                        e.windup = e.windup - dt
                        skip_normal_move = true
                        if e.windup <= 0 then
                            e.windup = 0
                            local dx = self.player_pos.x - e.x
                            local dy = self.player_pos.y - e.y
                            local d = math.sqrt(dx * dx + dy * dy)
                            if d > 0 then e.charge_vx = dx / d; e.charge_vy = dy / d end
                            e.charging = true; e.charge_time = 0.45
                            sfx.play("en_charge", { x = e.x })
                        end
                    else
                        e.charge_timer = (e.charge_timer or 2) - dt
                        if (e.charge_timer or 0) <= 0 and not stunned then
                            e.windup = 0.55
                            skip_normal_move = true
                            sfx.play("en_charge_windup", { x = e.x })
                        end
                    end
                elseif e.type == "boss" then
                    e.pattern_timer = (e.pattern_timer or 3) - dt
                    if (e.pattern_timer or 0) <= 0 then
                        e.pattern_timer = 3.0
                        e.pattern = ((e.pattern or 0) % 3) + 1
                        if e.pattern == 1 then
                            for k = 0, 7 do
                                local a = k * (math.pi * 2 / 8)
                                fire_enemy_bolt(self, e.x, e.y, e.x + math.cos(a) * 100, e.y + math.sin(a) * 100, 180, 8)
                            end
                            sfx.play("boss_ring", { x = e.x })
                        elseif e.pattern == 2 then
                            local dx = self.player_pos.x - e.x
                            local dy = self.player_pos.y - e.y
                            local d = math.sqrt(dx * dx + dy * dy)
                            if d > 0 then e.charge_vx = dx / d; e.charge_vy = dy / d end
                            e.charging = true; e.charge_time = 0.7
                            sfx.play("boss_charge", { x = e.x })
                        elseif e.pattern == 3 then
                            for s = 1, 2 do spawn_wisp_at(self, e.x + (s == 1 and -20 or 20), e.y) end
                            sfx.play("boss_summon", { x = e.x })
                        end
                    end
                    if e.charging then
                        e.charge_time = (e.charge_time or 0) - dt
                        move_enemy(self, e, e.x + (e.charge_vx or 0) * 260 * dt, e.y + (e.charge_vy or 0) * 260 * dt)
                        if e.id then go.set_position(vmath.vector3(e.x, e.y, 0), e.id) end
                        if (e.charge_time or 0) <= 0 then e.charging = false end
                        skip_normal_move = true
                    end
                end
                if e.type == "slinger" and not stunned and not blinded then
                    e.shoot_timer = (e.shoot_timer or 2) - dt
                    if (e.shoot_timer or 0) <= 0 and level_mod.los(self.level, e.x, e.y, self.player_pos.x, self.player_pos.y, 4) then
                        e.shoot_timer = 2.0
                        e.recoil = 0.22            -- visual pop, see src/game/anim.lua
                        fire_enemy_bolt(self, e.x, e.y, self.player_pos.x, self.player_pos.y, 220, 6)
                        sfx.play("en_slinger_shot", { x = e.x })
                    end
                end

                local move_speed = e.speed
                if slowed then move_speed = move_speed * 0.5 end

                if (not skip_normal_move) and (not stunned) and (not rooted) then
                    local tx, ty
                    if blinded then
                        -- Wander: pick a random heading and drift toward it
                        if (e.wander_timer or 0) <= 0 then
                            e.wander_target = math.random() * 2 * math.pi
                            e.wander_timer = 1.0
                        end
                        e.wander_timer = e.wander_timer - dt
                        tx = e.x + math.cos(e.wander_target) * move_speed * dt
                        ty = e.y + math.sin(e.wander_target) * move_speed * dt
                    else
                        local dx = self.player_pos.x - e.x
                        local dy = self.player_pos.y - e.y
                        local dist = math.sqrt(dx * dx + dy * dy)
                        if dist > 0 then
                            dx = dx / dist
                            dy = dy / dist
                        end
                        -- No clear line to the player? follow the flow field around the walls.
                        local has_los = dist <= 30 or level_mod.los(self.level, e.x, e.y, self.player_pos.x, self.player_pos.y, e.radius * 0.8)
                        if not has_los then
                            local fdx, fdy = level_mod.flow_dir(self.level, e.x, e.y)
                            if fdx then dx, dy = fdx, fdy end
                        end
                        if e.type == "slinger" and has_los then
                            -- ranged: back off when close, hold position at mid range
                            e.retreating = dist < 200
                            if dist < 200 then dx = -dx; dy = -dy
                            elseif dist < 260 then dx = 0; dy = 0 end
                        else
                            e.retreating = false
                        end
                        tx = e.x + dx * move_speed * dt
                        ty = e.y + dy * move_speed * dt
                    end

                    -- Add knockback velocity ON TOP of the chase/wander step
                    tx = tx + e.vx * dt
                    ty = ty + e.vy * dt
                    e.vx = e.vx * (1 - dt * 4) -- decay over ~0.25s
                    e.vy = e.vy * (1 - dt * 4)

                    move_enemy(self, e, tx, ty)
                    go.set_position(vmath.vector3(e.x, e.y, 0), e.id)
                end

                -- Update statuses
                local expired = status_mod.update(e, dt)
                for _, name in ipairs(expired) do
                    -- no per-status expiry handling needed yet
                end
                -- Tick reaction cooldowns
                reactions_mod.update(e, dt)
                -- Flare-up: expire burn dps multiplier
                if e.statuses and e.statuses.burn and e.statuses.burn.flare_expiry then
                    e.statuses.burn.flare_expiry = e.statuses.burn.flare_expiry - dt
                    if e.statuses.burn.flare_expiry <= 0 then
                        e.statuses.burn.dps_mul = nil
                        e.statuses.burn.flare_expiry = nil
                    end
                end

                -- Contact damage to player (skipped entirely for harmless/0-damage enemies,
                -- e.g. training dummies, so they never flash-screen the player)
                if not stunned then -- rooted can still attack
                    if e.contact_damage > 0 and enemies_mod.is_touching(e.x, e.y, e.radius, self.player_pos.x, self.player_pos.y, PLAYER_RADIUS) then
                        -- confuse: 50% of its attacks miss
                        local missed = status_mod.has(e, "confuse") and (math.random() < 0.5)
                        if not missed then
                            local died, applied = player_mod.take_damage(self.player, e.contact_damage)
                            if died then
                                print("PLAYER DEAD")
                                print("State: DEAD")
                                self.state = "DEAD"
                                sfx.play("pl_die", { x = self.player_pos.x })
                                sfx.play("state_dead", { x = self.player_pos.x })
                                music.set_state("DEAD")
                                break   -- one death message per frame, never per enemy
                            elseif applied then
                                print("Player HP: " .. self.player.hp)
                                self.screen_flash = 0.5
                                fx_player_hit(self)
                            end
                        end
                    end
                end
                end
            end
        end
        -- Enemies push each other apart so they never stack into one blob
        local ne = #self.enemies
        for _, e in ipairs(self.enemies) do e.px, e.py = e.x, e.y end
        for i = 1, ne - 1 do
            local ea = self.enemies[i]
            if ea.alive and ea.active then
                for j = i + 1, ne do
                    local eb = self.enemies[j]
                    if eb.alive and eb.active then
                        local ddx, ddy = eb.x - ea.x, eb.y - ea.y
                        local dd = math.sqrt(ddx * ddx + ddy * ddy)
                        local min_d = (ea.radius + eb.radius) * 0.9
                        if dd < min_d and dd > 0.001 then
                            local push = (min_d - dd) * 0.5
                            local nx, ny = ddx / dd, ddy / dd
                            ea.x = ea.x - nx * push; ea.y = ea.y - ny * push
                            eb.x = eb.x + nx * push; eb.y = eb.y + ny * push
                        end
                    end
                end
            end
        end
        for _, e in ipairs(self.enemies) do
            if e.alive and e.active and e.id then
                if level_mod.blocked(self.level, e.x, e.y, e.radius * 0.85) then e.x, e.y = e.px, e.py end
                sync_enemy_visual(self, e, dt)
            end
        end

        for i = #self.bolts, 1, -1 do
            local p = self.bolts[i]
            if not combat_mod.update_bolt(p, dt) then
                del_bolt(p)
                table.remove(self.bolts, i)
            else
                go.set_position(vmath.vector3(p.x, p.y, 0.02), p.id)
                if p.glow then go.set_position(vmath.vector3(p.x, p.y, 0.1), p.glow) end
                if p.flame then go.set_position(vmath.vector3(p.x, p.y, 0.11), p.flame) end
                p.anim_t = (p.anim_t or 0) - dt
                if p.anim_t <= 0 and p.skill and p.skill.elements then
                    p.anim_t = 0.07
                    -- element B sparkle shed from the flame; vapour compounds also leave a smoke puff
                    anim_fx(self, p.x, p.y, fxanim.PUFF, p.skill.elements[2], 26, nil, { z = 0.1 })
                    p.smoke_n = (p.smoke_n or 0) + 1
                    if p.smoke_n % 2 == 0 then smoke_puff(self, p.x, p.y, p.skill, 30, 0, 12) end
                end
                p.fx_timer = (p.fx_timer or 0) + dt
                if p.fx_timer >= 0.03 then
                    p.fx_timer = 0
                    local bc = (p.skill and p.skill.color) or { r = 1, g = 1, b = 1 }
                    -- Element A's trail sprite (spec 6.3); scratch art is rotated onto the flight path
                    local trail_art = element_fx(p.skill and p.skill.elements, 1, "trail")
                    local rot = nil
                    if DIRECTIONAL_FX[trail_art] and (p.vx or p.vy) then
                        rot = math.atan2(p.vy, p.vx) - math.pi / 4
                    end
                    spawn_particle(self, p.x, p.y, bc.r, bc.g, bc.b, 0.8, 0.45, 0.28, 0, 0, trail_art, 0.05, rot)
                end
                if p.x < -40 or p.x > ARENA_W + 40 or p.y < -40 or p.y > ARENA_H + 40 then p.ttl = 0 end
                if level_mod.is_solid(self.level, p.x, p.y) then
                    local wc = (p.skill and p.skill.color) or { r = 1, g = 1, b = 1 }
                    fx_hit(self, p.x, p.y, wc, element_fx(p.skill and p.skill.elements, 2, "hit"), p.skill)
                    p.ttl = 0
                end
                -- "leaves a trail": drop small puddles as the bolt flies
                if p.trail then
                    p.trail_timer = (p.trail_timer or 0) + dt
                    if p.trail_timer >= 0.12 then
                        p.trail_timer = p.trail_timer - 0.12
                        spawn_trail_puddle(self, p.x, p.y, p.trail_power, p.trail_color)
                    end
                end
                -- Check hit
                local hit_enemy = nil
                for _, e in ipairs(self.enemies) do
                    if e.alive and e.active and combat_mod.bolt_hits(p, e.x, e.y) then
                        hit_enemy = e
                        break
                    end
                end
                if hit_enemy then
                    p.hit = true
                    local pc = (p.skill and p.skill.color) or { r = 1, g = 1, b = 1 }
                    apply_hit(self, hit_enemy, p.power, p.statuses, {
                        kind = "bolt", x = p.x, y = p.y,
                        fx_x = p.x, fx_y = p.y,
                        skill = p.skill, color = pc,
                        hit_art = element_fx(p.skill and p.skill.elements, 2, "hit"),
                        fx = true,
                    })
                    del_bolt(p)
                    table.remove(self.bolts, i)
                end
            end
        end

        -- Update puddles
        for i = #self.puddles, 1, -1 do
            local pud = self.puddles[i]
            go.set_position(vmath.vector3(pud.x, pud.y, 0), pud.vis)
            if pud.color and pud.style then
                -- Pool: the compound's magic-circle effect pulses out every 0.6 s, alternating A/B colours
                pud.pulse_t = (pud.pulse_t or 0) - dt
                if pud.pulse_t <= 0 then
                    pud.pulse_t = 0.6
                    pud.pulse_n = (pud.pulse_n or 0) + 1
                    local el = pud.elements[(pud.pulse_n % 2) + 1]
                    anim_fx(self, pud.x, pud.y, pud.style.pool, el, pud.radius * 2.1, nil, { z = -0.27 })
                end
                pud.smoke_t = (pud.smoke_t or 0) - dt
                if pud.smoke_t <= 0 then
                    pud.smoke_t = 0.3
                    local ja = (pud.x * 0.37 + pud.y * 0.71 + (pud.pulse_n or 0) * 1.7) % 6.283
                    local jr = 0.55 * pud.radius * (0.4 + ((pud.pulse_n or 0) % 3) * 0.25)
                    smoke_puff(self, pud.x + math.cos(ja) * jr, pud.y + math.sin(ja) * jr, pud.skill_ref, 44, 0, 18)
                end
            end
            if pud.color then
                pud.fx_t = (pud.fx_t or 0) - dt
                if pud.fx_t <= 0 then
                    pud.fx_t = 0.1
                    local pa = math.random() * math.pi * 2
                    local pr = math.sqrt(math.random()) * pud.radius * 0.9
                    -- Rising embers/bubbles use element A's rise sprite, drifting upward (spec 6.3)
                    local rise_art = element_fx(pud.elements, 1, "rise")
                    spawn_particle(self, pud.x + math.cos(pa) * pr, pud.y + math.sin(pa) * pr,
                        pud.color.r, pud.color.g, pud.color.b, 0.7, 0.35, 0.6, 0, 40 + math.random() * 40, rise_art, 0.05)
                end
            end
            local hits = combat_mod.update_puddle(pud, dt, self.enemies)
            for _, h in ipairs(hits) do
                apply_hit(self, h.enemy, h.damage, h.statuses, {
                    kind = "puddle", x = pud.x, y = pud.y, skill = pud.skill_ref,
                })
            end
            if not pud.alive then
                go.delete(pud.vis)
                if pud.ring then go.delete(pud.ring) end
                table.remove(self.puddles, i)
            end
        end

        -- Update orbits
        for i = #self.orbits, 1, -1 do
            local orb = self.orbits[i]
            local hits = combat_mod.update_orbit(orb, dt, self.player_pos.x, self.player_pos.y, self.enemies)
            -- Update orb visuals
            orb.fx_t = (orb.fx_t or 0) - dt
            for j, ovis in ipairs(orb.vis) do
                local o = orb.orbs[j]
                go.set_position(vmath.vector3(o.x, o.y, 0.02), ovis)
                if orb.glow and orb.glow[j] then go.set_position(vmath.vector3(o.x, o.y, 0.1), orb.glow[j]) end
                if orb.flame and orb.flame[j] then go.set_position(vmath.vector3(o.x, o.y, 0.11), orb.flame[j]) end
                orb.anim_t = (orb.anim_t or 0) - dt / math.max(1, #orb.vis)
                if orb.anim_t <= 0 and orb.skill_ref and orb.skill_ref.elements then
                    orb.anim_t = 0.22
                    anim_fx(self, o.x, o.y, fxanim.PUFF, orb.skill_ref.elements[2], 24, nil, { z = 0.1 })
                    smoke_puff(self, o.x, o.y, orb.skill_ref, 30, 0, 10)
                end
                if orb.fx_t <= 0 and orb.color then
                    -- Orbit sparks use element A's trail sprite (spec 6.3)
                    spawn_particle(self, o.x, o.y, orb.color.r, orb.color.g, orb.color.b, 0.7, 0.35, 0.3, 0, 0,
                        element_fx(orb.elements, 1, "trail"), 0.05)
                end
            end
            if orb.fx_t <= 0 then orb.fx_t = 0.05 end
            -- "leaves a trail": each orb drops small puddles
            if orb.trail then
                orb.trail_timer = (orb.trail_timer or 0) + dt
                if orb.trail_timer >= 0.25 then
                    orb.trail_timer = orb.trail_timer - 0.25
                    for _, o in ipairs(orb.orbs) do
                        spawn_trail_puddle(self, o.x, o.y, orb.trail_power, orb.trail_color)
                    end
                end
            end
            for _, h in ipairs(hits) do
                apply_hit(self, h.enemy, h.damage, h.statuses, {
                    kind = "orbit", x = self.player_pos.x, y = self.player_pos.y,
                    skill = orb.skill_ref,
                })
            end
            if not orb.alive then
                for _, v in ipairs(orb.vis) do go.delete(v) end
                for _, v in ipairs(orb.glow or {}) do go.delete(v) end
                for _, v in ipairs(orb.flame or {}) do go.delete(v) end
                table.remove(self.orbits, i)
            end
        end

        -- Update cones (instant, visual duration)
        for i = #self.cones, 1, -1 do
            local c = self.cones[i]
            go.set_position(vmath.vector3(c.x, c.y, 0), c.vis)
            c.duration = c.duration - dt
            if c.duration <= 0 then
                go.delete(c.vis)
                table.remove(self.cones, i)
            end
        end

        -- Update bursts (instant, visual duration)
        for i = #self.bursts, 1, -1 do
            local b = self.bursts[i]
            go.set_position(vmath.vector3(b.x, b.y, 0), b.vis)
            b.duration = b.duration - dt
            if b.duration <= 0 then
                go.delete(b.vis)
                table.remove(self.bursts, i)
            end
        end

        -- Cooldowns
        if self.slot1_cooldown > 0 then self.slot1_cooldown = self.slot1_cooldown - dt end
        if self.slot2_cooldown > 0 then self.slot2_cooldown = self.slot2_cooldown - dt end

        -- Hold the mouse button to keep casting as soon as the cooldown is ready
        if self.hold1 and self.slot1_cooldown <= 0 then do_cast(self, 1) end
        if self.hold2 and self.slot2_cooldown <= 0 then do_cast(self, 2) end

        -- Repeat casts (quirk)
        for i = #self.repeat_casts, 1, -1 do
            local rc = self.repeat_casts[i]
            rc.time = rc.time - dt
            if rc.time <= 0 then
                do_cast(self, rc.slot, true)
                table.remove(self.repeat_casts, i)
            end
        end

        -- Update enemy bolts (ranged enemies / boss)
        for i = #self.enemy_bolts, 1, -1 do
            local b = self.enemy_bolts[i]
            b.life = b.life - dt
            b.x = b.x + b.vx * dt
            b.y = b.y + b.vy * dt
            if b.life <= 0 or b.x < 0 or b.x > ARENA_W or b.y < 0 or b.y > ARENA_H or level_mod.is_solid(self.level, b.x, b.y) then
                if b.id then go.delete(b.id) end
                table.remove(self.enemy_bolts, i)
            else
                go.set_position(vmath.vector3(b.x, b.y, 0), b.id)
                -- collision with player
                local dx = b.x - self.player_pos.x
                local dy = b.y - self.player_pos.y
                if self.state ~= "DEAD" and (dx * dx + dy * dy) < (PLAYER_RADIUS + 4) ^ 2 then
                    local died, applied = player_mod.take_damage(self.player, b.damage)
                    if died then
                        print("PLAYER DEAD")
                        print("State: DEAD")
                        self.state = "DEAD"
                        sfx.play("pl_die", { x = self.player_pos.x })
                        sfx.play("state_dead", { x = self.player_pos.x })
                        music.set_state("DEAD")
                        break
                    elseif applied then
                        print("Player HP: " .. self.player.hp)
                        self.screen_flash = 0.5
                        fx_player_hit(self)
                    end
                    if b.id then go.delete(b.id) end
                    table.remove(self.enemy_bolts, i)
                end
            end
        end
        if self.state == "DEAD" then
            -- skip
        else
        local any_alive = false
        for _, e in ipairs(self.enemies) do
            if e.alive then any_alive = true break end
        end
        if not any_alive and self.pending_wave and #self.pending_wave > 0 then
            -- wave 1 is dead: bring in wave 2
            for i, sp in ipairs(self.pending_wave) do
                spawn_telegraphed_wisp(self, sp.type, sp.x, sp.y)
                local e = self.enemies[#self.enemies]
                e.telegraph = 0.8 + (i - 1) * 0.15
            end
            self.pending_wave = {}
            spawn_particle(self, ARENA_W * 0.5, ARENA_H * 0.5, 1, 0.9, 0.5, 0.9, 0.5, 0.8, 0, 0, data.ART.particle.circle, 8.0)
            print("Wave 2")
        elseif not any_alive and self.spawned_count > 0 and self.room_clear_timer == nil then
            if self.boss then
                self.room_clear_timer = 1.0
            else
                self.room_clear_timer = 2.0
                self.player.hp = math.min(self.player.max_hp, self.player.hp + data.TUNING.HEAL_ON_CLEAR)
                spawn_particle(self, self.player_pos.x, self.player_pos.y, 0.4, 1, 0.5, 0.9, 0.4, 0.6, 0, 0, data.ART.particle.circle, 3.0)
                sfx.play("pl_heal", { x = self.player_pos.x })
                print("Room cleared (+" .. data.TUNING.HEAL_ON_CLEAR .. " HP)")
            end
            events.emit("room_clear", {
                self = self, room = self.room_index, boss = self.boss ~= nil,
            })
        end
        if self.room_clear_timer then
            self.room_clear_timer = self.room_clear_timer - dt
            if self.room_clear_timer <= 0 then
                self.room_clear_timer = nil
                if self.boss then
                    self.state = "WIN"
                    sfx.play("state_win", { x = self.player_pos.x })
                    music.set_state("WIN")
                    print("State: WIN")
                else
                    self.reward_options = generate_rewards(self)
                    self.state = "REWARD"
                    music.set_state("CAULDRON")
                    print("State: REWARD")
                end
            end
        end
    end
    end

    -- Update one-shot flipbook effects (the engine plays them; we only move and delete them)
    for i = #self.anims, 1, -1 do
        local a = self.anims[i]
        a.t = a.t - dt
        if a.vx ~= 0 or a.vy ~= 0 then
            a.x = a.x + a.vx * dt
            a.y = a.y + a.vy * dt
            go.set_position(vmath.vector3(a.x, a.y, a.z), a.id)
        end
        if a.t <= 0 then
            go.delete(a.id)
            table.remove(self.anims, i)
        end
    end

    -- Update particles (short-lived fading sprites)
    for i = #self.particles, 1, -1 do
        local p = self.particles[i]
        p.life = p.life - dt
        p.x = p.x + (p.vx or 0) * dt
        p.y = p.y + (p.vy or 0) * dt
        if p.id then
            local t = math.max(0, p.life / (p.max_life or 0.5))
            go.set_position(vmath.vector3(p.x, p.y, 0.1), p.id)
            local sc = lerp(p.s1 or 0.3, p.s0 or 0.3, t)
            go.set_scale(vmath.vector3(sc, sc, 1), p.id)
            go.set(msg.url(nil, p.id, "sprite"), "tint", vmath.vector4(p.r, p.g, p.b, (p.a or 1) * t))
        end
        if p.life <= 0 then
            if p.id then go.delete(p.id) end
            table.remove(self.particles, i)
        end
    end

    -- Screen flash decay
    if (self.screen_flash or 0) > 0 then
        self.screen_flash = self.screen_flash - dt
        if self.screen_flash < 0 then self.screen_flash = 0 end
    end

    -- M4: push the whole UI state to the HUD once per frame
    send_ui(self)
end

-- The window can be any size/aspect; the world is letterboxed into the 960x640 design area
-- (main/letterbox.render_script). action.x/y arrive stretched over the whole window, so undo that
-- stretch and the black bars to get design-space (world) coordinates.
local function to_design(ax, ay)
    local ww, wh = 0, 0
    if window and window.get_size then ww, wh = window.get_size() end
    if not ww or ww <= 0 or wh <= 0 then return ax, ay end
    local scale = math.min(ww / ARENA_W, wh / ARENA_H)
    local cw, ch = ARENA_W * scale / ww, ARENA_H * scale / wh      -- content share of the window
    local fx, fy = ax / ARENA_W, ay / ARENA_H
    local x = (fx - (1 - cw) * 0.5) / cw * ARENA_W
    local y = (fy - (1 - ch) * 0.5) / ch * ARENA_H
    return math.max(0, math.min(ARENA_W, x)), math.max(0, math.min(ARENA_H, y))
end

function on_input(self, action_id, action)
    -- Mouse aim
    if action_id == nil then
        self.aim.x, self.aim.y = to_design(action.x, action.y)
    end

    -- WASD
    if action_id == hash("up") then
        if action.pressed then self.keys.up = true
        elseif action.released then self.keys.up = false end
    elseif action_id == hash("left") then
        if action.pressed then self.keys.left = true
        elseif action.released then self.keys.left = false end
    elseif action_id == hash("down") then
        if action.pressed then self.keys.down = true
        elseif action.released then self.keys.down = false end
    elseif action_id == hash("right") then
        if action.pressed then self.keys.right = true
        elseif action.released then self.keys.right = false end
    end

    -- TITLE / DEAD / WIN: the HUD owns the buttons, it hit-tests and replies
    -- with a "ui_action" message (handled in on_message).

    -- M3 debug row (removed/hidden at the end via TUNING.DEBUG):
    --   1-5 = slot 1 shape, Q = cycle slot 1 compound, E = cycle slot 2 compound
    if data.TUNING.DEBUG and self.state ~= "REWARD" then
        if action_id == hash("1") and action.pressed then self.slot1_shape = "projectile"; rebuild_skills(self) end
        if action_id == hash("2") and action.pressed then self.slot1_shape = "puddle"; rebuild_skills(self) end
        if action_id == hash("3") and action.pressed then self.slot1_shape = "orbit"; rebuild_skills(self) end
        if action_id == hash("4") and action.pressed then self.slot1_shape = "cone"; rebuild_skills(self) end
        if action_id == hash("5") and action.pressed then self.slot1_shape = "burst"; rebuild_skills(self) end
        if action_id == hash("q") and action.pressed then cycle_compound(self, 1) end
        if action_id == hash("e") and action.pressed then cycle_compound(self, 2) end
        if action_id == hash("t") and action.pressed then toggle_training_room(self) end
        -- Audio audition row (O/P previous/next, L play, K cast slot 1's layers)
        local snd_ids = sfx.ids()
        if #snd_ids > 0 then
            if action_id == hash("sfx_prev") and action.pressed then
                self.sfx_debug_index = ((self.sfx_debug_index or 1) - 2) % #snd_ids + 1
                print(string.format("Sound %d/%d: %s", self.sfx_debug_index, #snd_ids, snd_ids[self.sfx_debug_index]))
            elseif action_id == hash("sfx_next") and action.pressed then
                self.sfx_debug_index = (self.sfx_debug_index or 1) % #snd_ids + 1
                print(string.format("Sound %d/%d: %s", self.sfx_debug_index, #snd_ids, snd_ids[self.sfx_debug_index]))
            elseif action_id == hash("sfx_play") and action.pressed then
                local id = snd_ids[self.sfx_debug_index or 1]
                local played = sfx.play(id)
                print(string.format("Sound %s: %s", id, played and "played" or "throttled/disabled"))
            elseif action_id == hash("sfx_cast") and action.pressed then
                if self.slot1 then
                    print("Sound cast layers: " .. tostring(self.slot1.compound) .. " " .. tostring(self.slot1.shape))
                    sfx.cast(self.slot1, self.player_pos and self.player_pos.x or ARENA_W * 0.5)
                else
                    print("Sound cast layers: no slot-1 skill")
                end
            end
        end
    end

    -- Hold-to-fire flags (the update loop casts while a button is held)
    if action_id == hash("cast1") then
        if action.pressed and self.state == "ROOM" then self.hold1 = true
        elseif action.released then self.hold1 = false end
    elseif action_id == hash("cast2") then
        if action.pressed and self.state == "ROOM" then self.hold2 = true
        elseif action.released then self.hold2 = false end
    end

    -- SPACE: dash (short invulnerable burst toward the move direction, or the aim point)
    if action_id == hash("dash") and action.pressed and self.state == "ROOM"
       and self.dash_cd <= 0 and self.dash_t <= 0 then
        local ddx = (self.keys.right and 1 or 0) - (self.keys.left and 1 or 0)
        local ddy = (self.keys.up and 1 or 0) - (self.keys.down and 1 or 0)
        if ddx == 0 and ddy == 0 then
            ddx = self.aim.x - self.player_pos.x
            ddy = self.aim.y - self.player_pos.y
        end
        local len = math.sqrt(ddx * ddx + ddy * ddy)
        if len < 0.001 then ddx, ddy, len = 1, 0, 1 end
        self.dash_dx, self.dash_dy = ddx / len, ddy / len
        self.dash_t = data.TUNING.DASH_TIME
        self.dash_cd = data.TUNING.DASH_COOLDOWN
        self.player.invuln = math.max(self.player.invuln, data.TUNING.DASH_TIME + 0.12)
        print("Dash")
        events.emit("dash", { self = self, x = self.player_pos.x, y = self.player_pos.y })
    end

    -- Reward pick via keyboard (1/2/3) when the mouse click path is unreliable
    if self.state == "REWARD" and action.pressed then
        if action_id == hash("1") and self.reward_options and self.reward_options[1] then
            handle_ui_action(self, { action = "reward_pick", index = 1 })
        elseif action_id == hash("2") and self.reward_options and self.reward_options[2] then
            handle_ui_action(self, { action = "reward_pick", index = 2 })
        elseif action_id == hash("3") and self.reward_options and self.reward_options[3] then
            handle_ui_action(self, { action = "reward_pick", index = 3 })
        end
    end

    -- LMB: cast in ROOM, otherwise hand the click to the HUD (menus)
    if action_id == hash("cast1") and action.pressed then
        if self.state == "ROOM" then
            if self.slot1_cooldown <= 0 then
                do_cast(self, 1)
            else
                print(string.format("Slot 1 on cooldown (%.2fs)", self.slot1_cooldown))
            end
        else
            -- REWARD state: handle clicks directly to avoid HUD state race conditions
            if self.state == "REWARD" then
                -- Card positions in design space (after HUD offset): (210,350), (480,350), (750,350)
                -- Card size: 180x220, so hit boxes: x±90, y±110
                local dx, dy = to_design(action.x, action.y)
                local cards = { {210, 350}, {480, 350}, {750, 350} }
                for i, c in ipairs(cards) do
                    if dx >= c[1] - 90 and dx <= c[1] + 90 and dy >= c[2] - 110 and dy <= c[2] + 110 then
                        if self.reward_options and self.reward_options[i] then
                            handle_ui_action(self, { action = "reward_pick", index = i })
                        else
                            handle_ui_action(self, { action = "reward_pick", index = 1 })
                        end
                        return
                    end
                end
                -- Fallback: if click is in the reward area but missed all cards, pick first
                if dy >= 200 and dy <= 500 then
                    handle_ui_action(self, { action = "reward_pick", index = 1 })
                end
            end
            local dx, dy = to_design(action.x, action.y)
            msg.post("/hud#gui", "click", { x = dx, y = dy })
        end
    end

    -- Cast slot 2 (RMB)
    if self.state == "ROOM" and action_id == hash("cast2") and action.pressed then
        if self.slot2_cooldown <= 0 then
            do_cast(self, 2)
        else
            print(string.format("Slot 2 on cooldown (%.2fs)", self.slot2_cooldown))
        end
    end
end

-- Cast a skill from the given slot (1 or 2)
do_cast = function(self, slot_num, is_repeat)
    local skill = slot_num == 1 and self.slot1 or self.slot2
    local power = skill.power
    local cooldown = skill.cooldown
    local radius = skill.radius
    local statuses = skill.statuses -- list of status names

    -- hide_self is applied to the PLAYER, not the enemies (4.4)
    local enemy_statuses = {}
    for _, name in ipairs(statuses or {}) do
        if name == "hide_self" then
            apply_status(self, self.player, { "hide_self" })
            print("hide_self: enemies lose track of you for 2s")
        else
            table.insert(enemy_statuses, name)
        end
    end
    statuses = enemy_statuses

    -- Quirk: costs 5% health
    if skill.quirk == "costs 5% health" then
        local cost = math.ceil(self.player.max_hp * 0.05)
        self.player.hp = self.player.hp - cost
        if self.player.hp < 1 then self.player.hp = 1 end
        power = power * 1.5
        print("Health cost quirk: -" .. cost .. " HP, power x1.5 -> " .. power)
    end

    -- Quirk: bigger but slower
    if skill.quirk == "bigger but slower" then
        radius = radius * 1.5
        cooldown = cooldown * 1.5
    end

    local sx, sy = self.player_pos.x, self.player_pos.y
    local tx, ty = self.aim.x, self.aim.y

    -- Determine skill color for visual tint
    local sc = skill.color
    fx_cast(self, sx, sy, sc, skill)
    events.emit("cast", { self = self, skill = skill, slot = slot_num, is_repeat = is_repeat, x = sx, y = sy })

    -- Quirk: splits in two
    local split = skill.quirk == "splits in two"

    -- Quirk: leaves a trail
    local trail = skill.quirk == "leaves a trail"

    -- Quirk: repeats once
    local repeat_once = skill.quirk == "repeats once"

    events.emit("quirk", {
        self = self, quirk = skill.quirk, raw = skill.quirk,
        skill = skill, x = sx, y = sy, is_repeat = is_repeat,
    })

    -- Audible cast: shape gesture + element A + compound signature, all at the recipe's pitch.
    -- A repeated cast is quieter; "bigger but slower" drops the whole cast 2 extra semitones.
    local pitch_mul = skill.quirk == "bigger but slower" and 2 ^ (-2 / 12) or 1
    sfx.cast(skill, sx, is_repeat and 0.6 or 1, pitch_mul)

    local shape = skill.shape -- e.g. "Bolt", "Pool" -> need key
    -- Map display name back to key
    local shape_key = nil
    for k, v in pairs(SHAPE_DISPLAY) do if v == shape then shape_key = k end end
    if not shape_key then shape_key = "projectile" end

    if shape_key == "projectile" then
        local projectiles = {}
        if split then
            -- Two copies at +/- 15 degrees
            local aim_angle = math.atan2(ty - sy, tx - sx)
            for _, offset in ipairs({ -math.rad(15), math.rad(15) }) do
                local a = aim_angle + offset
                local ex = sx + math.cos(a) * 400
                local ey = sy + math.sin(a) * 400
                table.insert(projectiles, { tx = ex, ty = ey, power = power * 0.6 })
            end
        else
            table.insert(projectiles, { tx = tx, ty = ty, power = power })
        end
        for _, pr in ipairs(projectiles) do
            local p = combat_mod.new_bolt(sx, sy, pr.tx, pr.ty, pr.power, 450)
            p.skill = skill
            local vis = factory.create("#visual_factory", vmath.vector3(p.x, p.y, 0.02))
            go.set_scale(vmath.vector3(0.2, 0.2, 1), vis)
            go.set(msg.url(nil, vis, "sprite"), "tint",
                vmath.vector4(lerp(sc.r, 1, 0.6), lerp(sc.g, 1, 0.6), lerp(sc.b, 1, 0.6), 1))
            sprite.play_flipbook(msg.url(nil, vis, "sprite"), hash(FX.core))
            go.set_scale(vmath.vector3(0.1, 0.1, 1), vis)      -- small hot core under the flame
            p.id = vis
            p.glow = fx_make(p.x, p.y, 0.1, FX.glow, sc.r, sc.g, sc.b, 0.95, 0.7)
            -- Animated flame head in element A's colour, tail pointing back along the flight path
            p.flame = flame_make(p.x, p.y, "headflame", skill.elements[1], 44)
            if p.flame then
                local fa = math.atan2(pr.ty - sy, pr.tx - sx)
                go.set_rotation(vmath.quat_rotation_z(fa + math.pi / 2), p.flame)
            end
            p.skill = skill
            p.statuses = statuses
            if trail then
                p.trail = true
                p.trail_power = power
                p.trail_color = sc
            end
            table.insert(self.bolts, p)
        end

    elseif shape_key == "puddle" then
        -- Clamp placement to max range 300 from the player (4.3)
        local pdx, pdy = tx - sx, ty - sy
        local plen = math.sqrt(pdx * pdx + pdy * pdy)
        local px, py = tx, ty
        if plen > 300 then
            px = sx + pdx / plen * 300
            py = sy + pdy / plen * 300
        end
        px, py = level_mod.last_free_on_ray(self.level, sx, sy, px, py)
        local puddles = {}
        if split then
            -- Two offset puddles
            table.insert(puddles, { x = px - 30, y = py, power = power })
            table.insert(puddles, { x = px + 30, y = py, power = power })
        else
            table.insert(puddles, { x = px, y = py, power = power })
        end
        for _, pd in ipairs(puddles) do
            local pud = combat_mod.new_puddle(pd.x, pd.y, radius, 5.0, pd.power, statuses)
            local scale = radius / 64 * 2 -- 64px art: diameter = 2 * radius
            pud.vis = fx_make(pd.x, pd.y, -0.3, FX.glow, sc.r, sc.g, sc.b, 0.55, scale * 0.85)
            pud.ring = fx_make(pd.x, pd.y, -0.29, data.ART.particle.circle, sc.r, sc.g, sc.b, 0.8, scale)
            pud.color = sc
            pud.elements = skill.elements
            pud.style = fxanim.COMPOUND[skill.compound]
            pud.skill_ref = skill
            table.insert(self.puddles, pud)
        end

    elseif shape_key == "orbit" then
        local num_orbs = 3
        if split then num_orbs = 2 end
        local orb = combat_mod.new_orbit(sx, sy, 70, num_orbs, 6.0, power, statuses)
        local vis = {}
        orb.glow = {}
        orb.flame = {}
        orb.skill_ref = skill
        orb.color = sc
        orb.elements = skill.elements
        for j = 1, num_orbs do
            local v = factory.create("#visual_factory", vmath.vector3(orb.orbs[j].x, orb.orbs[j].y, 0.02))
            go.set_scale(vmath.vector3(0.2, 0.2, 1), v)
            go.set(msg.url(nil, v, "sprite"), "tint",
                vmath.vector4(lerp(sc.r, 1, 0.6), lerp(sc.g, 1, 0.6), lerp(sc.b, 1, 0.6), 1))
            sprite.play_flipbook(msg.url(nil, v, "sprite"), hash(FX.core))
            table.insert(vis, v)
            table.insert(orb.glow, fx_make(orb.orbs[j].x, orb.orbs[j].y, 0.1, FX.glow, sc.r, sc.g, sc.b, 0.9, 0.55))
            go.set_scale(vmath.vector3(0.1, 0.1, 1), v)          -- tiny core under the flame
            -- Orbs alternate element A / element B flames so a mixed skill shows both colours
            local fl = flame_make(orb.orbs[j].x, orb.orbs[j].y, "orbflame", skill.elements[((j - 1) % 2) + 1], 40)
            if fl then table.insert(orb.flame, fl) end
        end
        orb.vis = vis
        if trail then
            orb.trail = true
            orb.trail_power = power
            orb.trail_color = sc
            orb.trail_timer = 0
        end
        table.insert(self.orbits, orb)

    elseif shape_key == "cone" then
        local aim_angle = math.atan2(ty - sy, tx - sx)
        local cones = {}
        if split then
            table.insert(cones, { angle = aim_angle - math.rad(20), power = power * 0.6 })
            table.insert(cones, { angle = aim_angle + math.rad(20), power = power * 0.6 })
        else
            table.insert(cones, { angle = aim_angle, power = power })
        end
        for _, cn in ipairs(cones) do
            local c = combat_mod.new_cone(sx, sy, cn.angle, 90, 70, cn.power, statuses)
            local hits = combat_mod.cone_hits(c, self.enemies)
            for _, h in ipairs(hits) do
                apply_hit(self, h.enemy, h.damage, h.statuses, {
                    kind = "cone", x = sx, y = sy,
                    skill = skill, color = sc, fx = true,
                })
            end
            c.vis = fx_make(sx, sy, 0.1, FX.glow, sc.r, sc.g, sc.b, 0.7, 1.0)
            local st = fxanim.COMPOUND[skill.compound]
            if st then
                -- The compound's sweep effect, rotated so it spreads along the aim; B colour layered behind
                local fam = fxanim.FAM[st.spray]
                local srot = fam and fam.face and (cn.angle - fam.face) or nil
                local ca_, sa_ = math.cos(cn.angle), math.sin(cn.angle)
                anim_fx(self, sx + ca_ * 38, sy + sa_ * 38, st.spray, skill.elements[2], 170, srot, { z = 0.115 })
                anim_fx(self, sx + ca_ * 58, sy + sa_ * 58, st.spray, skill.elements[1], 140, srot, { z = 0.12 })
                for k = 1, 4 do
                    local d = 30 + k * 22
                    smoke_puff(self, sx + ca_ * d, sy + sa_ * d, skill, 38, ca_ * 60, sa_ * 60)
                end
            end
            -- Spray fan alternates element A's and element B's sprites (spec 6.3)
            local ea_art = element_fx(skill.elements, 1, "trail")
            local eb_art = element_fx(skill.elements, 2, "trail")
            for k = 1, 14 do
                local ca = cn.angle + (math.random() - 0.5) * math.rad(70)
                local csp = 220 + math.random() * 260
                local ca_rot = nil
                local art = ((k % 2 == 0) and ea_art) or eb_art
                if DIRECTIONAL_FX[art] then ca_rot = ca - math.pi / 4 end
                spawn_particle(self, sx + math.cos(ca) * 14, sy + math.sin(ca) * 14, sc.r, sc.g, sc.b,
                    0.9, 0.55, 0.28, math.cos(ca) * csp, math.sin(ca) * csp,
                    art, 0.12, ca_rot)
            end
            table.insert(self.cones, c)
            if trail then
                spawn_trail_puddle(self, sx, sy, power, sc)
            end
        end

    elseif shape_key == "burst" then
        local b = combat_mod.new_burst(sx, sy, radius, power, statuses)
        local hits = combat_mod.burst_hits(b, self.enemies)
        for _, h in ipairs(hits) do
            apply_hit(self, h.enemy, h.damage, h.statuses, {
                kind = "burst", x = sx, y = sy,
                skill = skill, color = sc, fx = true,
            })
        end
        local scale = radius / 64 * 2
        b.vis = fx_make(sx, sy, 0.1, FX.glow, sc.r, sc.g, sc.b, 0.8, scale * 0.9)
        local nst = fxanim.COMPOUND[skill.compound]
        if nst then
            -- Outer burst in element A, a smaller counter-rotated burst in element B inside it
            anim_fx(self, sx, sy, nst.nova, skill.elements[1], radius * 2.4, nil, { z = 0.1 })
            anim_fx(self, sx, sy, nst.nova, skill.elements[2], radius * 1.5, math.pi / 5, { z = 0.11 })
            for k = 1, 6 do
                local sa = (k / 6) * math.pi * 2 + 0.3
                smoke_puff(self, sx + math.cos(sa) * 14, sy + math.sin(sa) * 14, skill, 52,
                    math.cos(sa) * radius * 1.1, math.sin(sa) * radius * 1.1)
            end
        end
        spawn_particle(self, sx, sy, sc.r, sc.g, sc.b, 1.0, 0.3, 0.38, 0, 0, data.ART.particle.circle, scale * 1.1)
        spawn_particle(self, sx, sy, 1, 1, 1, 0.8, 0.2, 0.25, 0, 0, data.ART.particle.circle, scale * 0.8)
        -- Nova spokes use element B's spoke sprite (spec 6.3)
        local eb_spoke = element_fx(skill.elements, 2, "spoke")
        for k = 1, 12 do
            local ba = (k / 12) * math.pi * 2
            local spoke_rot = nil
            if DIRECTIONAL_FX[eb_spoke] then spoke_rot = ba - math.pi / 4 end
            spawn_particle(self, sx, sy, sc.r, sc.g, sc.b, 0.9, 0.4, 0.35,
                math.cos(ba) * radius * 2.4, math.sin(ba) * radius * 2.4, eb_spoke, 0.1, spoke_rot)
        end
        table.insert(self.bursts, b)
        if trail then
            spawn_trail_puddle(self, sx, sy, power, sc)
        end

        -- Quirk: splits in two for burst = second smaller burst 0.3s later
        if split then
            local wid = self.world_id
            timer.delay(0.3, false, function()
                if self.state ~= "ROOM" or self.world_id ~= wid then return end
                local b2 = combat_mod.new_burst(sx, sy, radius * 0.7, power * 0.6, statuses)
                local hits2 = combat_mod.burst_hits(b2, self.enemies)
                for _, h in ipairs(hits2) do
                    -- The echo has never applied knockback; keep it that way (behaviour-neutral).
                    apply_hit(self, h.enemy, h.damage, h.statuses, {
                        kind = "echo", x = sx, y = sy, knockback = false,
                        skill = skill, color = sc, fx = true,
                    })
                end
                b2.vis = fx_make(sx, sy, 0.1, FX.glow, sc.r, sc.g, sc.b, 0.6, scale * 0.65)
                local nst2 = fxanim.COMPOUND[skill.compound]
                if nst2 then
                    anim_fx(self, sx, sy, nst2.nova, skill.elements[1], radius * 0.7 * 2.4, nil, { z = 0.1 })
                end
                spawn_particle(self, sx, sy, sc.r, sc.g, sc.b, 0.9, 0.2, 0.3, 0, 0, data.ART.particle.circle, scale * 0.8)
                table.insert(self.bursts, b2)
            end)
        end
    end

    -- Quirk: repeats once (never chain a repeat of a repeat)
    if repeat_once and not is_repeat then
        table.insert(self.repeat_casts, { slot = slot_num, time = 0.5 })
    end

    -- Set cooldown (after quirk modifications)
    if slot_num == 1 then
        self.slot1_cooldown = cooldown
        self.slot1_cd_max = cooldown
    else
        self.slot2_cooldown = cooldown
        self.slot2_cd_max = cooldown
    end

    print("Cast " .. skill.compound .. " " .. skill.shape .. " (power=" .. math.floor(power + 0.5) .. ", quirk=" .. skill.quirk .. ", cd=" .. string.format("%.2f", cooldown) .. "s)")
end

-- M4: the HUD replies here after hit-testing a click.
function on_message(self, message_id, message, sender)
    if message_id == hash("ui_action") then
        handle_ui_action(self, message)
    end
end