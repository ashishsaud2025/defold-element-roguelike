    panel_soft  = vmath.vector4(0.04, 0.05, 0.09, 0.72),
    box         = vmath.vector4(0.16, 0.18, 0.26, 1.0),
    box_ready   = vmath.vector4(0.22, 0.55, 0.35, 1.0),
    box_dim     = vmath.vector4(0.10, 0.11, 0.16, 1.0),
    slot_bg     = vmath.vector4(0.09, 0.10, 0.16, 1.0),
    cd          = vmath.vector4(0.0, 0.0, 0.0, 0.62),
    white       = vmath.vector4(1.0, 1.0, 1.0, 1.0),
    dim         = vmath.vector4(0.55, 0.60, 0.72, 1.0),
    hp          = vmath.vector4(0.85, 0.25, 0.32, 1.0),
    hp_bg       = vmath.vector4(0.16, 0.10, 0.14, 1.0),
    dead        = vmath.vector4(0.90, 0.25, 0.25, 1.0),
    win         = vmath.vector4(0.35, 0.85, 0.45, 1.0),
    pick_off    = vmath.vector4(0.18, 0.20, 0.28, 1.0),
    toast       = vmath.vector4(1.0, 0.88, 0.35, 1.0),
}

