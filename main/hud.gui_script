-- /main/hud.gui_script
-- M4 UI. Drawing + hit testing only: all game state lives in game.script and
-- arrives as a "ui" message every frame. Clicks are forwarded back as
-- "ui_action" messages so the game script owns the state machine.
--
-- Coordinate space: 960x640, origin at the screen centre, +y up.
-- GUI scripts have no go.* namespace (README 5.4 / 6).
local data = require "src.core.data"
local art_mod = require "src.core.art"
local combos = require "src.core.combos"
local credits_mod = require "src.core.credits"
local relics_mod = require "src.core.relics"
local layout = require "src.ui.layout"

-- Long static text is built HERE from data, never shipped through msg.post
-- (the engine's 2 KB message budget overflowed at element #18 when credits
-- rode along on every frame). This is the only sanctioned path.

local ELEM_ORDER = { "fire", "water", "wind", "earth" }
