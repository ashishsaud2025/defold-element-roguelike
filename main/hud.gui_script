-- Only ids authored in main/hud.gui may be touched by the uniform text-scale
-- pass; specs for ids that do not exist in hud.gui are skipped.
local ALL_SET = {}
for _, id in ipairs(ALL_NODES) do ALL_SET[id] = true end

local function n(id)
    return gui.get_node(id)
end

local function show(id, on)
    local node = n(id)
    if node then gui.set_enabled(node, on) end
end

local function text(id, s)
    local node = n(id)
    if node then gui.set_text(node, s) end
end

local function color(id, c)
    local node = n(id)
    if node then gui.set_color(node, c) end
end

-- Left-anchored bar: default pivot is the node centre, so shifting x by
-- half the scaled width keeps the left edge fixed. (Design space, origin bottom-left.)
local function bar(id, left, width, center_y, frac)
    local node = n(id)
    if not node then return end
    frac = math.max(0, math.min(1, frac))
    gui.set_scale(node, vmath.vector3(math.max(frac, 0.001), 1, 1))
    gui.set_position(node, vmath.vector3(left + width * frac * 0.5, center_y, 0))
end

-- Bottom-anchored bar: the fill shrinks from the top down as the fraction falls.
-- Used for the cooldown overlay, which drains toward the bottom of the slot.
local function vbar(id, left, width, bottom, height, frac)
    local node = n(id)
    if not node then return end
    frac = math.max(0.001, math.min(1, frac))
    gui.set_scale(node, vmath.vector3(1, frac, 1))
    gui.set_position(node, vmath.vector3(left + width * 0.5, bottom + height * frac * 0.5, 0))
end

local function elem_color(name)
    local e = data.ELEMENTS[name]
    if not e then return C.dim end
    return vmath.vector4(e.r, e.g, e.b, 1.0)
end

-- Element icons are white art in the shared atlas, so tinting with the
-- element color is all that is needed. Play the matching flipbook.
local function set_icon(id, elem)
    local node = n(id)
    if node and elem then
        gui.play_flipbook(node, hash(art_mod.ELEMENT_ICONS[elem] or ("icon_" .. elem)))
    end
end

-- Swap a box node's atlas image only when it changes (hover skins on the CAULDRON art).
local function skin(self, id, anim)
    self.skins = self.skins or {}
    if self.skins[id] ~= anim then
        self.skins[id] = anim
        local node = n(id)
        if node then gui.play_flipbook(node, hash(anim)) end
    end
end

-- Atlas flipbooks are ONCE_FORWARD, so loop by restarting from the complete callback.
local function loop_flipbook(id, anim, offset)
    local node = n(id)
    if not node then return end
    gui.play_flipbook(node, hash(anim), function(_, nd)
        gui.play_flipbook(nd, hash(anim), function() end)
    end, offset and { offset = offset } or nil)
end

local CD_GOLD  = vmath.vector4(1.00, 0.82, 0.30, 1.0)
local CD_CREAM = vmath.vector4(1.00, 0.92, 0.66, 1.0)
local CD_INK   = vmath.vector4(0.20, 0.12, 0.05, 1.0)
local SHAPE_TINT = {
    projectile = vmath.vector4(1.00, 0.82, 0.25, 1.0),
    puddle     = vmath.vector4(0.40, 0.70, 1.00, 1.0),
    orbit      = vmath.vector4(0.95, 0.70, 0.25, 1.0),
    cone       = vmath.vector4(0.45, 0.75, 1.00, 1.0),
    burst      = vmath.vector4(1.00, 0.65, 0.20, 1.0),
}

-- Pure-pool reaction hint for the cauldron: which different-element areas a
-- pure pool of this element reacts with. Built from data.REACTIONS +
-- data.COMBO_BY_ID (single source). The fire-pool + wind cell belongs to
-- Fire Cyclone and never yields a reaction (src/game/reaction.lua).
local function pure_pool_hint(el)
    local order = { "fire", "water", "wind", "earth" }
    local parts = {}
    for _, other in ipairs(order) do
        if other ~= el and not (el == "fire" and other == "wind") then
            local key = (el < other) and (el .. "+" .. other) or (other .. "+" .. el)
            local rid = data.REACTIONS[key]
            local com = rid and data.COMBO_BY_ID[rid]
            if com then
                parts[#parts + 1] = "VS " .. other:upper() .. " = " .. com.name
            end
        end
    end
    return table.concat(parts, "   ")
end

-- Phase B: shared rect helpers (design space, bottom-left origin).
local function point_in_rect(b, x, y)
    return x >= b.x and x <= b.x + b.w and y >= b.y and y <= b.y + b.h
end

-- Create the two new panel nodes (border + fill) for a screen, title bar included.
-- Returns { border, fill, bar, title } handles for show/hide in render().
local function make_panel_nodes(spec, layer)
    local b = spec.border
    local fill = spec.fill
    local bar = spec.title_bar
    local border = gui.new_box_node(vmath.vector3(b.x + b.w * 0.5, b.y + b.h * 0.5, 0), vmath.vector3(b.w, b.h, 0))
    gui.set_color(border, vmath.vector4(layout.palette.panel_border.r, layout.palette.panel_border.g, layout.palette.panel_border.b, layout.palette.panel_border.a))
    gui.set_layer(border, layer)
    gui.set_enabled(border, false)
    local body = gui.new_box_node(vmath.vector3(fill.x + fill.w * 0.5, fill.y + fill.h * 0.5, 1), vmath.vector3(fill.w, fill.h, 0))
    gui.set_color(body, vmath.vector4(layout.palette.panel.r, layout.palette.panel.g, layout.palette.panel.b, layout.palette.panel.a))
    gui.set_layer(body, layer)
    gui.set_enabled(body, false)
    local handle = { border = border, fill = body }
    if bar then
        handle.bar = gui.new_box_node(vmath.vector3(bar.x + bar.w * 0.5, bar.y + bar.h * 0.5, 2), vmath.vector3(bar.w, bar.h, 0))
        gui.set_color(handle.bar, vmath.vector4(layout.palette.panel_title.r, layout.palette.panel_title.g, layout.palette.panel_title.b, layout.palette.panel_title.a))
        gui.set_layer(handle.bar, layer)
        gui.set_enabled(handle.bar, false)
    end
    return handle
end

local function panel_enabled(p, on)
    if not p then return end
    gui.set_enabled(p.border, on)
    gui.set_enabled(p.fill, on)
    if p.bar then gui.set_enabled(p.bar, on) end
end

local function screen_buttons(screen)
    return (layout.SCREENS[screen] or {}).buttons or {}
end

-- Convert a palette table { r,g,b,a } to a vmath vector (GUI colors are vectors).
local function pv(t) return vmath.vector4(t.r, t.g, t.b, t.a) end

local function apply_layout(self)
    local T = layout.SCREENS.TITLE.texts
    local function pos(id, x, y) if n(id) then gui.set_position(n(id), vmath.vector3(x, y, 0)) end end
    local function pos_rect(id, r) if r then pos(id, r.x + r.w * 0.5, r.y + r.h * 0.5) end end
    -- Full-screen nodes: always the full 960x640 rect (centre 480,320).
    -- Never rely on the authored position.
    pos_rect("panel", layout.FULL_SCREEN)
    pos_rect("flash_box", layout.FULL_SCREEN)

    -- TITLE
    pos("title_text", T.title_text.x, T.title_text.y)
    color("title_text", pv(layout.palette.text))
    pos("subtitle_text", T.subtitle_text.x, T.subtitle_text.y)
    color("subtitle_text", pv(layout.palette.text_dim))
    pos("version_text", T.version_text.x, T.version_text.y)
    text("version_text", T.version_text.text)
    color("version_text", pv(layout.palette.text_dim))
    local TITLE_TEXT = { start_box = "start_text", combos_box = "combos_text", credits_box = "credits_text_btn",
                         settings_box = "settings_text", training_box = "training_text", exit_box = "exit_text" }
    for _, b in ipairs(layout.SCREENS.TITLE.buttons) do
        local text_id = TITLE_TEXT[b.id]
        pos_rect(b.id, b)
        color(b.id, pv(layout.palette.box))
        if text_id and n(text_id) then pos(text_id, b.text.x, b.text.y) end
    end

    -- ===== PAUSED =====
    local PP = layout.SCREENS.PAUSED
    pos("paused_title", PP.texts.paused_title.x, PP.texts.paused_title.y)
    color("paused_title", pv(layout.palette.text))
    for _, b in ipairs(PP.buttons) do
        pos_rect(b.id, b)
        color(b.id, pv(layout.palette.box))
        local text_id = b.id:gsub("_box$", "_text")
        pos(text_id, b.text.x, b.text.y)
        color(text_id, pv(layout.palette.text))
    end

    -- ===== SETTINGS =====
    local ST = layout.SCREENS.SETTINGS
    pos("settings_title", ST.texts.settings_title.x, ST.texts.settings_title.y)
    color("settings_title", pv(layout.palette.text))
    pos("bindings_title", ST.texts.bindings_title.x, ST.texts.bindings_title.y)
    color("bindings_title", pv(layout.palette.text_dim))
    for _, k in ipairs({ "master", "sfx", "music" }) do
        local label = ST.texts[k .. "_label"]
        pos(k .. "_label", label.x, label.y)
        color(k .. "_label", pv(layout.palette.text))
        local value = ST.texts[k .. "_value"]
        pos(k .. "_value", value.x, value.y)
        color(k .. "_value", pv(layout.palette.text))
        for _, side in ipairs({ "minus", "plus" }) do
            local bid = k .. "_" .. side .. "_box"
            local b = nil
            for _, btn in ipairs(ST.buttons) do if btn.id == bid then b = btn end end
            if b then
                pos_rect(bid, b)
                color(bid, pv(layout.palette.box))
                local tid = bid:gsub("_box$", "_text")
                pos(tid, b.text.x, b.text.y)
                color(tid, pv(layout.palette.text))
            end
        end
        local bar = ST.bars[k .. "_bar"]
        pos(k .. "_bar", bar.x + bar.w * 0.5, bar.y + bar.h * 0.5)
        pos(k .. "_fill", bar.x, bar.y + bar.h * 0.5)   -- left anchor; render scales + shifts x
        color(k .. "_bar", pv(layout.palette.cd))
        color(k .. "_fill", pv(layout.palette.accent_gold))
    end
    for _, k in ipairs({ "up", "left", "down", "right", "cast1", "cast2", "interact", "dash" }) do
        local lab = ST.texts["row_" .. k .. "_label"]
        local val = ST.texts["row_" .. k .. "_bind_text"]
        pos("row_" .. k .. "_label", lab.x, lab.y)
        color("row_" .. k .. "_label", pv(layout.palette.text_dim))
        pos("row_" .. k .. "_bind_text", val.x, val.y)
        color("row_" .. k .. "_bind_text", pv(layout.palette.text))
        for _, btn in ipairs(ST.buttons) do
            if btn.id == "row_" .. k .. "_bind_box" then
                pos_rect("row_" .. k .. "_bind_box", btn)
                color("row_" .. k .. "_bind_box", pv(layout.palette.slot_bg))
            end
        end
    end
    pos("capture_note", ST.texts.capture_note.x, ST.texts.capture_note.y)
    color("capture_note", pv(layout.palette.text_dim))
    for _, btn in ipairs(ST.buttons) do
        if btn.id == "settings_back_box" then
            pos_rect("settings_back_box", btn)
            color("settings_back_box", pv(layout.palette.box))
            pos("settings_back_text", btn.text.x, btn.text.y)
            color("settings_back_text", pv(layout.palette.text))
        end
    end

    -- COMBOS / CREDITS share the panel component
    for _, screen in ipairs({ "COMBOS", "CREDITS" }) do
        local S = layout.SCREENS[screen]
        pos("credits_title", S.texts.credits_title.x, S.texts.credits_title.y)
        color("credits_title", pv(layout.palette.text))
        pos("credits_body", S.texts.credits_body.x, S.texts.credits_body.y)
        color("credits_body", pv(layout.palette.text))
        local bb = S.buttons[1]
        pos_rect(bb.id, bb)
        color("back_box", pv(layout.palette.box))
        pos("back_text", bb.text.x, bb.text.y)
    end

    -- ===== HOME_EDIT =====
    local E = layout.SCREENS.HOME_EDIT
    pos("loadout_title", E.texts.loadout_title.x, E.texts.loadout_title.y)
    color("loadout_title", pv(layout.palette.text))
    pos("loadout_preview", E.texts.loadout_preview.x, E.texts.loadout_preview.y)
    color("loadout_preview", pv(layout.palette.text))
    pos("loadout_quirk_desc", E.texts.loadout_quirk_desc.x, E.texts.loadout_quirk_desc.y)
    color("loadout_quirk_desc", pv(layout.palette.text_dim))
    for i, f in ipairs({ "ea", "eb", "shape", "quirk" }) do
        local y = ({ 464, 396, 328, 260 })[i]
        pos("row_" .. f .. "_label", E.texts["row_" .. f .. "_label"].x, E.texts["row_" .. f .. "_label"].y)
        color("row_" .. f .. "_label", pv(layout.palette.text_dim))
        pos("row_" .. f .. "_val", E.texts["row_" .. f .. "_val"].x, E.texts["row_" .. f .. "_val"].y)
        color("row_" .. f .. "_val", pv(layout.palette.text))
    end
    for _, b in ipairs(E.buttons) do
        pos_rect(b.id, b)
        if b.id == "done_box" then
            color("done_box", pv(layout.palette.box))
        else
            color(b.id, pv(layout.palette.slot_bg))
        end
        if b.text and b.text.x then
            local id = b.id:gsub("_box$", "_text")
            if n(id) then pos(id, b.text.x, b.text.y); color(id, pv(layout.palette.text)) end
        end
    end

    -- ===== ROOM HUD =====
    local R = layout.SCREENS.ROOM
    local hp = R.hp_bar
    pos("hp_bg", hp.x + hp.w * 0.5, hp.y + hp.h * 0.5)
    color("hp_bg", pv(layout.palette.hp_bg))
    pos("hp_fill", hp.x + hp.w * 0.5, hp.y + hp.h * 0.5)
    color("hp_fill", pv(layout.palette.hp))
    pos("hp_text", R.texts.hp_text.x, R.texts.hp_text.y)
    color("hp_text", pv(layout.palette.text))
    pos("room_text", R.texts.room_text.x, R.texts.room_text.y)
    color("room_text", pv(layout.palette.text))
    for i = 1, 3 do
        local prefix = "s" .. i
        local slot = R["slot_" .. prefix]
        pos(prefix .. "_bg", slot.x + slot.w * 0.5, slot.y + slot.h * 0.5)
        color(prefix .. "_bg", pv(layout.palette.slot_bg))
        pos(prefix .. "_cd", slot.x + slot.w * 0.5, slot.y + slot.h * 0.5)
        color(prefix .. "_cd", pv(layout.palette.cd))
        pos(prefix .. "_frame", slot.x + slot.w * 0.5, slot.y + slot.h * 0.5)
        pos_rect(prefix .. "_key", R["key_" .. prefix])
        pos_rect(prefix .. "_shape_icon", R["shape_icon_" .. prefix])
        pos_rect(prefix .. "_dot1", R["dot1_" .. prefix])
        pos_rect(prefix .. "_dot2", R["dot2_" .. prefix])
        pos(prefix .. "_quirk", R.texts[prefix .. "_quirk"].x, R.texts[prefix .. "_quirk"].y)
        color(prefix .. "_quirk", pv(layout.palette.text_dim))
    end
    pos("portrait", R.portrait.x + R.portrait.w * 0.5, R.portrait.y + R.portrait.h * 0.5)
    pos("dash_bg", R.dash_bar.x + R.dash_bar.w * 0.5, R.dash_bar.y + R.dash_bar.h * 0.5)
    pos("dash_fill", R.dash_bar.x + R.dash_bar.w * 0.5, R.dash_bar.y + R.dash_bar.h * 0.5)
    for i = 1, 4 do
        local step = R.relic_bar.slot + R.relic_bar.gap
        pos("relic" .. i, R.relic_bar.x + R.relic_bar.slot * 0.5 + (i - 1) * step, R.relic_bar.y + R.relic_bar.slot * 0.5)
    end
    for i = 1, 5 do
        local step = R.pips.size + R.pips.gap
        pos("echo_pip" .. i, R.pips.x + R.pips.size * 0.5 + (i - 1) * step, R.pips.y + R.pips.size * 0.5)
        color("echo_pip" .. i, pv(layout.palette.box_dim))
    end
    pos("help_text", R.texts.help_text.x, R.texts.help_text.y)
    color("help_text", pv(layout.palette.text_dim))

    -- ===== REWARD =====
    local RW = layout.SCREENS.REWARD
    pos("reward_title", RW.texts.reward_title.x, RW.texts.reward_title.y)
    color("reward_title", pv(layout.palette.text))
    for i = 1, 3 do
        local card = RW.cards[i]
        pos("card" .. i .. "_box", card.x + card.w * 0.5, card.y + card.h * 0.5)
        color("card" .. i .. "_box", pv(layout.palette.box))
        pos("card" .. i .. "_frame", card.x + card.w * 0.5, card.y + card.h * 0.5)
        local icon = RW.cards[i].icon
        pos("card" .. i .. "_icon", icon.x + icon.w * 0.5, icon.y + icon.h * 0.5)
        local name = RW.texts["card" .. i .. "_text"]
        pos("card" .. i .. "_text", name.x, name.y)
        color("card" .. i .. "_text", pv(layout.palette.text))
        local tag = RW.texts["card" .. i .. "_tag"]
        pos("card" .. i .. "_tag", tag.x, tag.y)
        color("card" .. i .. "_tag", pv(layout.palette.text_dim))
        local desc = RW.texts["card" .. i .. "_desc"]
        pos("card" .. i .. "_desc", desc.x, desc.y)
        color("card" .. i .. "_desc", pv(layout.palette.text_dim))
    end

    -- ===== CAULDRON =====
    local CD = layout.SCREENS.CAULDRON
    for id, r in pairs(CD.art) do
        pos_rect(id, r)
        color(id, vmath.vector4(1, 1, 1, 1))
    end
    -- every text: position, alignment (w = left edge, e = right edge, else centred), colour
    for id, spec in pairs(CD.texts) do
        pos(id, spec.x, spec.y)
        local node = n(id)
        if node then
            gui.set_pivot(node, spec.align == "w" and gui.PIVOT_W or (spec.align == "e" and gui.PIVOT_E or gui.PIVOT_CENTER))
            color(id, pv(layout.palette[spec.color or "text"]))
        end
    end
    color("cauldron_title", CD_CREAM)
    color("ing_title", CD_CREAM)
    color("shape_title", CD_CREAM)
    color("cd_status", CD_INK)
    color("craft1_text", CD_CREAM)
    color("craft2_text", CD_CREAM)
    color("preview_name", CD_GOLD)
    color("relic_title", CD_CREAM)
    for i = 1, 4 do
        pos_rect("ing_icon_" .. i, CD.ing_icons[i])
    end
    for i = 1, 5 do
        pos_rect("ing_shape_icon_" .. i, CD.ing_shape_icons[i])
    end
    for _, s in ipairs(CD.slots) do
        pos_rect(s.box, s)
        pos_rect(s.icon, layout.ALL_RECT_RECT[s.icon])
        color(s.box, vmath.vector4(1, 1, 1, 1))
    end
    for i = 1, 2 do
        local b = (i == 1) and CD.craft1_box or CD.craft2_box
        pos_rect("craft" .. i .. "_box", b)
        color("craft" .. i .. "_box", vmath.vector4(1, 1, 1, 1))
    end
    pos_rect("done_box", CD.done_box)
    color("done_box", pv(layout.palette.box))
    pos_rect("cd_done_art", CD.art.cd_done_art)

    -- ===== DEAD / WIN =====
    for _, screen in ipairs({ "DEAD", "WIN" }) do
        local D = layout.SCREENS[screen]
        pos("overlay_title", D.texts.overlay_title.x, D.texts.overlay_title.y)
        pos("death_room", D.texts.death_room.x, D.texts.death_room.y)
        pos("death_relics", D.texts.death_relics.x, D.texts.death_relics.y)
        pos("overlay_hint", D.texts.overlay_hint.x, D.texts.overlay_hint.y)
        color("overlay_hint", pv(layout.palette.text_dim))
    end

    -- One source of truth for text scale: spec.size / 14 (the builtin font
    -- renders 14 px at scale 1). Only authored ids participate. The fixed-advance
    -- width and vertical fit math in the F1 audit, tools/validate_ui.py and
    -- tools/hud_test.lua is exact against this scale.
    for _, scr in pairs(layout.SCREENS) do
        for id, spec in pairs(scr.texts or {}) do
            if ALL_SET[id] then
                local node = n(id)
                if node then gui.set_scale(node, vmath.vector3(spec.size / 14, spec.size / 14, 1)) end
            end
        end
    end
end

local ROLL_TEXT = "THE JOURNEY HAS JUST BEGUN\n\nThank you for playing\n\n" .. table.concat(credits_mod, "\n\n")

-- long headlines (the ending) need a smaller scale than the 40 px layout size
local function story_title_scale(t)
    if t and #t > 18 then return 28 / 14 end
    return 40 / 14
end

local function render(self)
    local st = self.state
    local over = (st == "DEAD" or st == "WIN")
    local hud = (st == "ROOM" or over)
    local reward = (st == "REWARD")
    local cauldron = (st == "CAULDRON")
    local editor = (st == "HOME_EDIT")
    local paused = (st == "PAUSED")
    local settings = (st == "SETTINGS")
    local story = (st == "STORY")
    local roll = (st == "ROLL")

    -- Panel
    show("panel", st == "TITLE" or st == "COMBOS" or st == "CREDITS" or over or reward or editor or paused or settings or story or roll)
    color("panel", over and C.panel_soft or C.panel)
    -- STORY: the panel becomes a dialogue box along the bottom of the window
    if story then
        gui.set_size(n("panel"), vmath.vector3(880, 190, 0))
        gui.set_position(n("panel"), vmath.vector3(480, 111, 0))
        color("panel", C.panel)
    else
        gui.set_size(n("panel"), vmath.vector3(960, 640, 0))
        gui.set_position(n("panel"), vmath.vector3(480, 320, 0))
    end
    if not story then
        gui.set_pivot(n("overlay_title"), gui.PIVOT_CENTER)
        gui.set_pivot(n("credits_body"), gui.PIVOT_CENTER)
        gui.set_pivot(n("overlay_hint"), gui.PIVOT_CENTER)
    end
    panel_enabled(self.panel_combos, st == "COMBOS")
    panel_enabled(self.panel_credits, st == "CREDITS")
    panel_enabled(self.panel_cauldron, false)   -- the CAULDRON screen is drawn by the cd_* art nodes
    panel_enabled(self.panel_home_edit, editor)
    panel_enabled(self.panel_paused, paused)
    panel_enabled(self.panel_settings, settings)

    -- TITLE
    if st == "TITLE" then
        local hx, hy = self.hover_x, self.hover_y
        for _, b in ipairs(layout.SCREENS.TITLE.buttons) do
            local node_id = b.id
            if b.enabled == false then
                color(node_id, pv(layout.palette.box_dim))
            elseif hx and point_in_rect(b, hx, hy) then
                color(node_id, pv(layout.palette.box_hover))
            else
                color(node_id, pv(layout.palette.box))
            end
        end
    end

    -- PAUSED (buttons highlight on hover)
    if st == "PAUSED" then
        local hx, hy = self.hover_x, self.hover_y
        for _, b in ipairs(layout.SCREENS.PAUSED.buttons) do
            if hx and point_in_rect(b, hx, hy) then
                color(b.id, pv(layout.palette.box_hover))
            else
                color(b.id, pv(layout.palette.box))
            end
        end
    end

    -- SETTINGS (volume +/- rows and every binding row light up on hover)
    if st == "SETTINGS" then
        local hx, hy = self.hover_x, self.hover_y
        local ST = layout.SCREENS.SETTINGS
        for _, b in ipairs(ST.buttons) do
            if hx and point_in_rect(b, hx, hy) then
                color(b.id, pv(layout.palette.box_hover))
            else
                color(b.id, pv(layout.palette.slot_bg))
            end
        end
        -- the back button is the one in palette box land, not slot_bg
        local hx2, hy2 = self.hover_x, self.hover_y
        local bb = nil
        for _, b in ipairs(ST.buttons) do
            if b.id == "settings_back_box" then bb = b end
        end
        if bb then color("settings_back_box", (hx2 and hy2 and point_in_rect(bb, hx2, hy2)) and pv(layout.palette.box_hover) or pv(layout.palette.box)) end
        -- live volume readout + binding labels
        if self.volume then
            for _, k in ipairs({ "master", "sfx", "music" }) do
                local v = self.volume[k] or 0
                text(k .. "_value", string.format("%.1f", v))
                local tbl = ST.bars[k .. "_bar"]
                bar(k .. "_fill", tbl.x, tbl.w, tbl.y + tbl.h * 0.5, v)
            end
        end
        if self.bindings then
            for _, k in ipairs({ "up", "left", "down", "right", "cast1", "cast2", "interact", "dash" }) do
                local label = self.bindings[k] or "?"
                text("row_" .. k .. "_bind_text", label)
                color("row_" .. k .. "_bind_text", (self.capture == k) and pv(layout.palette.accent_gold) or pv(layout.palette.text))
            end
        end
        if self.capture then
            text("capture_note", "PRESS ANY KEY TO BIND  ·  ESC CANCELS")
            color("capture_note", pv(layout.palette.toast))
        else
            text("capture_note", "click a key row to rebind - duplicates reassign the key")
            color("capture_note", pv(layout.palette.text_dim))
        end
    end

    -- Title group
    show("title_text", st == "TITLE")
    show("subtitle_text", st == "TITLE")
    show("version_text", st == "TITLE")
    show("start_box", st == "TITLE")
    show("start_text", st == "TITLE")
    show("combos_box", st == "TITLE")
    show("combos_text", st == "TITLE")
    show("credits_box", st == "TITLE")
    show("credits_text_btn", st == "TITLE")
    show("settings_box", st == "TITLE")
    show("settings_text", st == "TITLE")
    show("training_box", st == "TITLE")
    show("training_text", st == "TITLE")
    show("exit_box", st == "TITLE")
    show("exit_text", st == "TITLE")

    -- Credits group (also reused for the COMBOS panel)
    show("credits_title", st == "CREDITS" or st == "COMBOS")
    show("credits_body", st == "CREDITS" or st == "COMBOS")
    show("back_box", st == "CREDITS" or st == "COMBOS")
    show("back_text", st == "CREDITS" or st == "COMBOS")
    if st == "COMBOS" then
        text("credits_title", "COMBOS")
        text("credits_body", combos.panel_text())
        local bb = layout.SCREENS.COMBOS.buttons[1]
        local hx, hy = self.hover_x, self.hover_y
        if hx and point_in_rect(bb, hx, hy) then
            color("back_box", pv(layout.palette.box_hover))
        else
            color("back_box", pv(layout.palette.box))
        end
    elseif st == "CREDITS" then
        text("credits_title", "CREDITS")
        text("credits_body", table.concat(credits_mod, "\n"))
        local bb = layout.SCREENS.CREDITS.buttons[1]
        local hx, hy = self.hover_x, self.hover_y
        if hx and point_in_rect(bb, hx, hy) then
            color("back_box", pv(layout.palette.box_hover))
        else
            color("back_box", pv(layout.palette.box))
        end
    end

    -- HUD group
    for _, id in ipairs({ "hp_bg", "hp_fill", "hp_text",
                          "s1_bg", "s1_cd", "s1_quirk", "s1_dot1", "s1_dot2",
                          "s2_bg", "s2_cd", "s2_quirk", "s2_dot1", "s2_dot2",
                          "s3_bg", "s3_cd", "s3_quirk", "s3_dot1", "s3_dot2",
                          "s1_shape_icon", "s2_shape_icon", "s3_shape_icon",
                          "s1_frame", "s2_frame", "s3_frame",
                          "s1_key", "s2_key", "s3_key",
                          "portrait", "dash_bg", "dash_fill",
                          "relic1", "relic2", "relic3", "relic4",
                          "echo_pip1", "echo_pip2", "echo_pip3", "echo_pip4", "echo_pip5" }) do
        show(id, hud)
    end
    show("help_text", hud or st == "HOME")
    show("room_text", st == "ROOM")

    -- Editor group (the altar's modal)
    for _, id in ipairs({ "loadout_title", "loadout_preview", "loadout_quirk_desc",
                          "tab_mouse_box", "tab_mouse_text", "tab_q_box", "tab_q_text",
                          "tab_r_box", "tab_r_text",
                          "row_ea_label", "row_ea_val", "row_ea_prev_box", "row_ea_prev_text", "row_ea_next_box", "row_ea_next_text",
                          "row_eb_label", "row_eb_val", "row_eb_prev_box", "row_eb_prev_text", "row_eb_next_box", "row_eb_next_text",
                          "row_shape_label", "row_shape_val", "row_shape_prev_box", "row_shape_prev_text", "row_shape_next_box", "row_shape_next_text",
                          "row_quirk_label", "row_quirk_val", "row_quirk_prev_box", "row_quirk_prev_text", "row_quirk_next_box", "row_quirk_next_text" }) do
        show(id, editor)
    end
    show("done_box", editor or cauldron)
    show("done_text", editor or cauldron)

    -- Reward group
    show("reward_title", reward)
    for i = 1, 3 do
        show("card" .. i .. "_box", reward)
        show("card" .. i .. "_text", reward)
        show("card" .. i .. "_frame", reward)
        show("card" .. i .. "_icon", reward)
        show("card" .. i .. "_tag", reward)
        show("card" .. i .. "_desc", reward)
    end

    -- Cauldron group
    show("cauldron_title", cauldron)
    show("ing_title", cauldron)
    show("shape_title", cauldron)
    for _, id in ipairs({ "ing_icon_1", "ing_icon_2", "ing_icon_3", "ing_icon_4",
                          "ing_elem_1", "ing_elem_2", "ing_elem_3", "ing_elem_4",
                          "ing_shape_1", "ing_shape_2", "ing_shape_3", "ing_shape_4", "ing_shape_5",
                          "sel_ea_box", "sel_ea_text", "sel_eb_box", "sel_eb_text",
                          "sel_shape_box", "sel_shape_text",
                          "slot_icon_ea", "slot_icon_eb", "slot_icon_shape",
                          "preview_name", "preview_detail", "preview_quirk", "preview_status",
                          "reaction_hint",
                          "craft1_box", "craft1_text", "craft2_box", "craft2_text",
                          "relic_title", "relic_1",
                          "cd_bg", "cd_ing_panel", "cd_title_banner", "cd_scroll", "cd_preview_panel", "cd_done_art",
                          "cd_small_box_1", "cd_small_box_2", "cd_gem", "cd_trophy", "cd_hl_1", "cd_hl_2", "cd_hl_s",
                          "cd_preview_icon", "cd_card_icon_1", "cd_card_icon_2", "cd_smoke_1", "cd_smoke_2", "cd_smoke_3",
                          "cd_status", "ing_cnt_1", "ing_cnt_2", "ing_cnt_3", "ing_cnt_4",
                          "ing_shcnt_1", "ing_shcnt_2", "ing_shcnt_3", "ing_shcnt_4", "ing_shcnt_5",
                          "ing_shape_icon_1", "ing_shape_icon_2", "ing_shape_icon_3", "ing_shape_icon_4", "ing_shape_icon_5",
                          "ing_info_1", "ing_info_2" }) do
        show(id, cauldron)
    end

    -- PAUSED group
    for _, id in ipairs({ "paused_title", "resume_box", "resume_text",
                          "paused_settings_box", "paused_settings_text",
                          "quit_box", "quit_text", "quit_main_box", "quit_main_text" }) do
        show(id, paused)
    end

    -- SETTINGS group
    for _, id in ipairs({ "settings_title",
                          "master_label", "master_value", "master_minus_box", "master_minus_text", "master_plus_box", "master_plus_text", "master_bar", "master_fill",
                          "sfx_label", "sfx_value", "sfx_minus_box", "sfx_minus_text", "sfx_plus_box", "sfx_plus_text", "sfx_bar", "sfx_fill",
                          "music_label", "music_value", "music_minus_box", "music_minus_text", "music_plus_box", "music_plus_text", "music_bar", "music_fill",
                          "bindings_title",
                          "row_up_label", "row_up_bind_box", "row_up_bind_text",
                          "row_left_label", "row_left_bind_box", "row_left_bind_text",
                          "row_down_label", "row_down_bind_box", "row_down_bind_text",
                          "row_right_label", "row_right_bind_box", "row_right_bind_text",
                          "row_cast1_label", "row_cast1_bind_box", "row_cast1_bind_text",
                          "row_cast2_label", "row_cast2_bind_box", "row_cast2_bind_text",
                          "row_interact_label", "row_interact_bind_box", "row_interact_bind_text",
                          "row_dash_label", "row_dash_bind_box", "row_dash_bind_text",
                          "capture_note", "settings_back_box", "settings_back_text" }) do
        show(id, settings)
    end

    -- Death / win group
    for _, id in ipairs({ "overlay_title", "overlay_hint" }) do
        show(id, over or story)
    end
    for _, id in ipairs({ "death_room", "death_relics" }) do
        show(id, over)
    end

    -- Screen flash on damage
    local fa = math.min(0.8, (self.flash or 0) * 1.6)
    if fa > 0 then
        show("flash_box", true)
        color("flash_box", vmath.vector4(1.0, 0.25, 0.2, fa))
    else
        show("flash_box", false)
    end

    if hud then
        local room_layout = layout.SCREENS.ROOM
        local hp = room_layout.hp_bar
        local frac = 0
        if self.max_hp > 0 then frac = self.hp / self.max_hp end
        bar("hp_fill", hp.x, hp.w, hp.y + hp.h * 0.5, frac)
        text("hp_text", math.floor(self.hp + 0.5) .. " / " .. self.max_hp)

        for i = 1, 3 do
            local prefix = "s" .. i
            local d = i == 1 and self.s1 or (i == 2 and self.s2 or self.s3)
            local slot = room_layout["slot_" .. prefix]
            if d then
                text(prefix .. "_quirk", d.quirk_short or d.quirk)
                local maxcd = d.cd_max or 0
                local frac = 0
                if maxcd > 0 then frac = d.cd / maxcd end
                vbar(prefix .. "_cd", slot.x, slot.w, slot.y, slot.h, frac)
                gui.play_flipbook(n(prefix .. "_frame"), hash(d.cd <= 0 and "slot_frame_ready" or "slot_frame"))
                color(prefix .. "_dot1", elem_color(d.ea))
                color(prefix .. "_dot2", elem_color(d.eb))
                set_icon(prefix .. "_dot1", d.ea)
                set_icon(prefix .. "_dot2", d.eb)
                if d.shape then
                    gui.play_flipbook(n(prefix .. "_shape_icon"), hash(SHAPE_ICON[d.shape] or "particle_flare"))
                end
            else
                text(prefix .. "_quirk", "")
                vbar(prefix .. "_cd", slot.x, slot.w, slot.y, slot.h, 0.001)
                gui.play_flipbook(n(prefix .. "_frame"), hash("slot_frame"))
            end
        end
        local dash = room_layout.dash_bar
        local dash_frac = 1 - (self.dash_cd or 0) / data.TUNING.DASH_COOLDOWN
        bar("dash_fill", dash.x, dash.w, dash.y + dash.h * 0.5, math.max(0.001, dash_frac))
        text("room_text", self.boss and ("Boss: " .. math.floor(self.boss_hp + 0.5) .. " / " .. self.boss_max_hp) or ("Room " .. (self.room or 0)))

        -- Owned relics (one icon per owned relic, icon from relics.DEFS).
        for i, rid in ipairs(RELIC_ORDER) do
            local owned = self.relics and self.relics[rid]
            show("relic" .. i, st == "ROOM" and owned ~= nil)
            if owned then
                local def = relics_mod.DEFS[rid]
                gui.play_flipbook(n("relic" .. i), hash(def and def.icon or "icon_rune"))
                color("relic" .. i, pv(layout.palette.accent_gold))
            end
        end

        -- Echoing Crystal: 5 pips, advance on the player's own casts only.
        local has_echo = (st == "ROOM" and self.relics ~= nil and self.relics["echoing_crystal"] == true)
        for i = 1, 5 do
            show("echo_pip" .. i, has_echo)
        end
        if has_echo then
            local done, total = relics_mod.echo_progress(self.relics, self.casts or 0)
            for i = 1, 5 do
                if i <= done then
                    color("echo_pip" .. i, pv(layout.palette.accent_gold))
                else
                    color("echo_pip" .. i, pv(layout.palette.box_dim))
                end
            end
        end

        -- Control line: one owner for help_text. Priority: banner > training-altar
        -- prompt > relic tip > default. Only touched when the winner changes.
        local toast = self.toast
        -- Relic hover tooltip candidate (ROOM only); resolved below into the same chain.
        local hover_rid = nil
        local hx, hy = self.hover_x, self.hover_y
        if st == "ROOM" and hx and hy and self.relics and not self.toast then
            for i, rid in ipairs(RELIC_ORDER) do
                if self.relics[rid] then
                    local step = room_layout.relic_bar.slot + room_layout.relic_bar.gap
                    local rect = { x = room_layout.relic_bar.x + (i - 1) * step, y = room_layout.relic_bar.y,
                                   w = room_layout.relic_bar.slot, h = room_layout.relic_bar.slot }
                    if point_in_rect(rect, hx, hy) then hover_rid = rid; break end
                end
            end
        end
        -- Winner of the line (re-resolved every frame, applied only on change).
        local line_key, line_text, line_color, line_scale
        if toast then
            line_key, line_text, line_color, line_scale = "toast", toast, C.toast, 0.95
        elseif st == "ROOM" and self.prompt then
            line_key, line_text, line_color, line_scale = "prompt", self.prompt, pv(layout.palette.accent_gold), 0.8
        elseif hover_rid then
            line_key, line_text, line_color, line_scale = "tip:" .. hover_rid, relics_mod.describe(hover_rid), pv(layout.palette.text), 0.7
        else
            line_key, line_text, line_color, line_scale = "default", self.help_default or "", pv(layout.palette.text_dim), 0.7
        end
        if self.line_key ~= line_key then
            self.line_key = line_key
            text("help_text", line_text)
            color("help_text", line_color)
            gui.set_scale(n("help_text"), vmath.vector3(line_scale, line_scale, 1))
        end
        -- Legacy fields kept consistent (banner bookkeeping used by other paths).
        self.toast_shown = toast
        self.relic_tip = (not toast) and hover_rid or nil
    end

    if reward then
        text("reward_title", "CHOOSE A REWARD")
        local opts = self.reward_options or {}
        local hx, hy = self.hover_x, self.hover_y
        local RW = layout.SCREENS.REWARD
        for i = 1, 3 do
            local opt = opts[i]
            local i_id = "card" .. i
            if opt then
                local is_relic = opt.kind == "relic"
                local name, tag, desc
                if opt.kind == "element" then
                    local el = data.ELEMENTS[opt.id]
                    name = ELEM_LABEL[opt.id] or string.upper(opt.id)
                    tag = "ELEMENT"
                    desc = (el and el.role) or ""
                    set_icon(i_id .. "_icon", opt.id)
                    color(i_id .. "_icon", elem_color(opt.id))
                elseif opt.kind == "shape" then
                    local s = data.SHAPES[opt.id]
                    name = s and s.name:upper() or string.upper(opt.id)
                    tag = "SHAPE"
                    desc = (s and s.blurb) or ""
                    gui.play_flipbook(n(i_id .. "_icon"), hash(SHAPE_ICON[opt.id] or "particle_flare"))
                    color(i_id .. "_icon", pv(layout.palette.text))
                elseif opt.kind == "relic" then
                    local def = relics_mod.DEFS[opt.id]
                    name = def and string.upper(def.name) or string.upper(opt.id)
                    tag = "RELIC"
                    desc = (def and def.desc) or ""
                    gui.play_flipbook(n(i_id .. "_icon"), hash(opt.icon or (def and def.icon) or "icon_rune"))
                    color(i_id .. "_icon", pv(layout.palette.accent_gold))
                else
                    name, tag, desc = "???", "?", ""
                end
                text(i_id .. "_text", name)
                text(i_id .. "_tag", tag)
                color(i_id .. "_tag", pv(is_relic and layout.palette.accent_gold or layout.palette.text_dim))
                local wrapped = layout.wrap(desc, 24)
                if #wrapped > 2 then wrapped = { wrapped[1], wrapped[2] } end
                text(i_id .. "_desc", table.concat(wrapped, "\n"))
                color(i_id .. "_frame", pv(is_relic and layout.palette.accent_gold or layout.palette.panel_border))
                color(i_id .. "_box", pv(layout.palette.box))
                if hx and point_in_rect(RW.cards[i], hx, hy) then
                    color(i_id .. "_box", pv(layout.palette.box_hover))
                end
            end
        end
    end

    if cauldron then
        local inv = self.inventory
        local CD = layout.SCREENS.CAULDRON
        local c = self.cauldron or {}
        local hx, hy = self.hover_x, self.hover_y
        local WHITE = vmath.vector4(1, 1, 1, 1)
        local function idx_of(list, v)
            for i, x in ipairs(list) do if x == v then return i end end
        end

        -- ===== ingredients panel: icon, name (left), count (right); picked rows are gold =====
        for i, el in ipairs(ELEM_ORDER) do
            local count = inv and inv.elements and inv.elements[el] or 0
            local picked = (c.ea == el or c.eb == el)
            text("ing_elem_" .. i, ELEM_LABEL[el])
            text("ing_cnt_" .. i, "x" .. count)
            set_icon("ing_icon_" .. i, el)
            local ec = elem_color(el)
            color("ing_icon_" .. i, count > 0 and ec or vmath.vector4(ec.x * 0.45, ec.y * 0.45, ec.z * 0.45, 1))
            color("ing_elem_" .. i, picked and CD_GOLD or (count > 0 and C.white or C.dim))
            color("ing_cnt_" .. i, count > 0 and CD_GOLD or C.dim)
        end
        for i, sh in ipairs(SHAPE_ORDER) do
            local s = data.SHAPES[sh] or {}
            local count = inv and inv.shapes and inv.shapes[sh] or 0
            local picked = (c.shape == sh)
            text("ing_shape_" .. i, s.name or sh)
            text("ing_shcnt_" .. i, "x" .. count)
            gui.play_flipbook(n("ing_shape_icon_" .. i), hash(SHAPE_ICON[sh] or "particle_flare"))
            local t = SHAPE_TINT[sh] or C.white
            color("ing_shape_icon_" .. i, count > 0 and t or vmath.vector4(t.x * 0.45, t.y * 0.45, t.z * 0.45, 1))
            color("ing_shape_" .. i, picked and CD_GOLD or (count > 0 and C.white or C.dim))
            color("ing_shcnt_" .. i, count > 0 and CD_GOLD or C.dim)
        end
        -- gold row highlights under the picked rows
        local hl_x = CD.art.cd_hl_1.x + CD.art.cd_hl_1.w * 0.5
        local function hl(id, idx, prefix)
            local node = n(id)
            if not node then return end
            if idx then
                gui.set_position(node, vmath.vector3(hl_x, CD.texts[prefix .. idx].y, 0))
                gui.set_enabled(node, true)
            else
                gui.set_enabled(node, false)
            end
        end
        local ia, ib = idx_of(ELEM_ORDER, c.ea), idx_of(ELEM_ORDER, c.eb)
        hl("cd_hl_1", ia, "ing_elem_")
        hl("cd_hl_2", (ib ~= ia) and ib or nil, "ing_elem_")
        hl("cd_hl_s", idx_of(SHAPE_ORDER, c.shape), "ing_shape_")

        -- ===== the three ingredient tiles =====
        local slot_defs = {
            { box = "sel_ea_box", icon = "slot_icon_ea", text_id = "sel_ea_text", field = "ea", label = "1. ELEMENT A", kind = "elem" },
            { box = "sel_eb_box", icon = "slot_icon_eb", text_id = "sel_eb_text", field = "eb", label = "2. ELEMENT B", kind = "elem" },
            { box = "sel_shape_box", icon = "slot_icon_shape", text_id = "sel_shape_text", field = "shape", label = "3. SHAPE", kind = "shape" },
        }
        for k, s in ipairs(slot_defs) do
            local v = c[s.field]
            if s.kind == "elem" then
                set_icon(s.icon, v)
                color(s.icon, v and elem_color(v) or pv(layout.palette.pick_off))
                local count = (v and inv and inv.elements and inv.elements[v]) or 0
                text(s.text_id, s.label .. "\n" .. (v and ELEM_LABEL[v] or "-") .. "\nowned x" .. count)
            else
                if v then gui.play_flipbook(n(s.icon), hash(SHAPE_ICON[v] or "particle_flare")) end
                color(s.icon, v and (SHAPE_TINT[v] or C.white) or pv(layout.palette.pick_off))
                local count = (v and inv and inv.shapes and inv.shapes[v]) or 0
                local sname = v and ((data.SHAPES[v] and data.SHAPES[v].name) or v):upper() or "-"
                text(s.text_id, s.label .. "\n" .. sname .. "\nowned x" .. count)
            end
            local over_tile = hx and point_in_rect(CD.slots[k], hx, hy)
            skin(self, s.box, over_tile and "cd_tile_hot" or "cd_tile")
            color(s.box, WHITE)
        end

        -- ===== status scroll =====
        text("cd_status", self.preview and "READY - CRAFT into a slot, then DONE to enter next room"
                                        or "MISSING INGREDIENTS - click a tile to pick others")

        -- ===== spell preview (animated element flame as the icon) =====
        local p = self.preview
        local ico = n("cd_preview_icon")
        if p then
            text("preview_name", p.name)
            text("preview_detail", "Power: " .. (p.power or "?") .. "   Cooldown: " .. string.format("%.1fs", p.cooldown or 0))
            text("preview_quirk", "Quirk: " .. (p.quirk or "-"))
            local sts = p.statuses
            text("preview_status", (sts and #sts > 0) and ("Statuses: " .. table.concat(sts, ", ")) or "No status")
            if c.shape == "puddle" and c.ea and c.ea == c.eb then
                text("reaction_hint", pure_pool_hint(c.ea))
            else
                text("reaction_hint", "")
            end
            if ico then
                gui.set_enabled(ico, true)
                color("cd_preview_icon", WHITE)
                local key = "fxa_headflame_" .. tostring(c.ea or "fire")
                if self.cd_prev_key ~= key then
                    self.cd_prev_key = key
                    loop_flipbook("cd_preview_icon", key)
                end
            end
        else
            text("preview_name", "No ingredients")
            text("preview_detail", "")
            text("preview_quirk", "")
            text("preview_status", "Ingredients missing from inventory.")
            text("reaction_hint", "")
            if ico then gui.set_enabled(ico, false) end
            self.cd_prev_key = nil
        end

        -- ===== the two craft cards: what the slot holds now =====
        local slot_names = self.slot_names or {}
        for i = 1, 2 do
            local cur = slot_names[i]
            local name, short = "empty", "-"
            if type(cur) == "table" then
                name = cur.name or "empty"
                short = string.upper(cur.quirk or "-")
            elseif cur then
                name = tostring(cur)
            end
            text("craft" .. i .. "_text", "CRAFT -> SLOT " .. i .. "\nwas: " .. string.sub(name, 1, 13) .. "\nquirk: " .. short)
            local over_card = hx and point_in_rect(i == 1 and CD.craft1_box or CD.craft2_box, hx, hy)
            skin(self, "craft" .. i .. "_box", over_card and "cd_card_hot" or "cd_card")
            color("craft" .. i .. "_box", WHITE)
            set_icon("cd_card_icon_" .. i, c.ea)
            color("cd_card_icon_" .. i, (p and c.ea) and elem_color(c.ea) or pv(layout.palette.pick_off))
        end

        -- ===== relic summary (top-right) =====
        local owned_n, first_name = 0, nil
        for _, rid in ipairs(RELIC_ORDER) do
            if self.relics and self.relics[rid] then
                owned_n = owned_n + 1
                if not first_name then first_name = (relics_mod.DEFS[rid] or {}).name or rid end
            end
        end
        text("relic_title", "Relics: " .. owned_n .. "/" .. #RELIC_ORDER)
        text("relic_1", first_name and (first_name .. (owned_n > 1 and "+" or "")) or "None yet")
        color("relic_1", first_name and CD_GOLD or C.dim)

        -- ===== DONE button: the art is the cd_done_art node; done_box stays as the invisible hit area =====
        color("done_box", vmath.vector4(1, 1, 1, 0))
        local over_done = hx and point_in_rect(CD.done_box, hx, hy)
        skin(self, "cd_done_art", over_done and "cd_btn_done_hot" or "cd_btn_done")
        text("done_text", "DONE - ENTER ROOM")

        -- ===== smoke puffs over the cauldron (Free Smoke Fx Pixel 2, looped) =====
        if not self.cd_smoke_on then
            self.cd_smoke_on = true
            local tint = vmath.vector4(0.80, 0.55, 1.0, 0.85)
            for i = 1, 3 do
                color("cd_smoke_" .. i, tint)
                loop_flipbook("cd_smoke_" .. i, "fxa_smoke_a", (i - 1) / 3)
            end
        end
    else
        self.cd_smoke_on = false
        self.cd_prev_key = nil
        if editor then color("done_box", C.box) end
        text("done_text", "Done")
    end

    if editor then
        local ed = self.editor
        if ed then
            text("row_ea_val", tostring(ed.ea_label or "-"))
            text("row_eb_val", tostring(ed.eb_label or "-"))
            text("row_shape_val", tostring(ed.shape_label or "-"))
            text("row_quirk_val", ed.quirk_short and string.upper(ed.quirk_short) or "-")
            text("loadout_preview", tostring(ed.preview_name or ""))
            text("loadout_quirk_desc", tostring(ed.quirk_desc or ""))
            -- the MOUSE basic is always a Bolt: the SHAPE row is a static BOLT
            if ed.tab == 3 then
                text("row_shape_val", "BOLT")
                color("row_shape_val", C.dim)
                color("row_shape_prev_box", pv(layout.palette.pick_off))
                color("row_shape_next_box", pv(layout.palette.pick_off))
            else
                color("row_shape_val", C.white)
                color("row_shape_prev_box", pv(layout.palette.slot_bg))
                color("row_shape_next_box", pv(layout.palette.slot_bg))
            end
            local hx, hy = self.hover_x, self.hover_y
            if hx and hy then
                for _, b in ipairs(layout.SCREENS.HOME_EDIT.buttons) do
                    if b.id ~= "done_box" and point_in_rect(b, hx, hy) then
                        color(b.id, pv(layout.palette.box_hover))
                    end
                end
            end
            local function blend(a, b, f)
                return vmath.vector4(a.r + (b.r - a.r) * f, a.g + (b.g - a.g) * f,
                                     a.b + (b.b - a.b) * f, 1.0)
            end
            local slot_bg = layout.palette.slot_bg
            local text_white = layout.palette.text
            local selected_text = layout.palette.accent_gold
            local tab_match = { tab_mouse_box = 3, tab_q_box = 1, tab_r_box = 2 }
            for box, slot in pairs(tab_match) do
                local text_id = box:gsub("_box$", "_text")
                if ed.tab == slot then
                    color(box, blend(slot_bg, selected_text, 0.55))
                    color(text_id, pv(selected_text))
                else
                    color(box, pv(slot_bg))
                    color(text_id, pv(text_white))
                end
            end
        end
    end

    if st == "HOME" then
        text("help_text", self.prompt or self.help_default or "")
        color("help_text", pv(layout.palette.text_dim))
        gui.set_scale(n("help_text"), vmath.vector3(0.7, 0.7, 1))
    end

    if over then
        local win = st == "WIN"
        text("overlay_title", win and "YOU WIN" or "YOU DIED")
        color("overlay_title", win and C.win or C.dead)
        text("death_room", "Reached Room " .. (self.room or 0))
        color("death_room", pv(layout.palette.text))
        local names = {}
        for _, rid in ipairs(RELIC_ORDER) do
            if self.relics and self.relics[rid] then
                local def = relics_mod.DEFS[rid]
                names[#names + 1] = def and def.name or rid
            end
        end
        text("death_relics", #names > 0 and ("Relics: " .. table.concat(names, ", ")) or "Relics: none")
        color("death_relics", pv(layout.palette.text_dim))
        text("overlay_hint", "Click anywhere to continue")
        color("overlay_hint", pv(layout.palette.text_dim))
    end

    -- STORY: dialogue / chest / ending pages (reuses the overlay title + the credits body node)
    if not (st == "CREDITS" or st == "COMBOS") then show("credits_title", false) end
    if not story then gui.set_scale(n("overlay_title"), vmath.vector3(40 / 14, 40 / 14, 1)) end
    if story then
        -- left-aligned dialogue: speaker on top, text below, hint bottom-right
        gui.set_pivot(n("overlay_title"), gui.PIVOT_W)
        gui.set_position(n("overlay_title"), vmath.vector3(70, 186, 0))
        gui.set_scale(n("overlay_title"), vmath.vector3(22 / 14, 22 / 14, 1))
        text("overlay_title", self.story_title or "")
        color("overlay_title", C.win)
        show("credits_body", true)
        gui.set_pivot(n("credits_body"), gui.PIVOT_NW)
        gui.set_position(n("credits_body"), vmath.vector3(70, 162, 0))
        gui.set_scale(n("credits_body"), vmath.vector3(16 / 14, 16 / 14, 1))
        text("credits_body", self.story_body or "")
        color("credits_body", pv(layout.palette.text))
        gui.set_pivot(n("overlay_hint"), gui.PIVOT_E)
        gui.set_position(n("overlay_hint"), vmath.vector3(890, 32, 0))
        gui.set_scale(n("overlay_hint"), vmath.vector3(12 / 14, 12 / 14, 1))
        text("overlay_hint", self.story_hint or "Click to continue")
        color("overlay_hint", pv(layout.palette.text_dim))
    elseif roll then
        -- slow credits roll: the body scrolls up from below the screen
        show("credits_body", true)
        gui.set_scale(n("credits_body"), vmath.vector3(18 / 14, 18 / 14, 1))
        text("credits_body", ROLL_TEXT)
        color("credits_body", pv(layout.palette.text))
        gui.set_position(n("credits_body"), vmath.vector3(480, -260 + (self.roll_t or 0) * 50, 0))
    else
        if st == "CREDITS" or st == "COMBOS" then
            gui.set_scale(n("credits_body"), vmath.vector3(1, 1, 1))
            gui.set_position(n("credits_body"), vmath.vector3(480, 330, 0))
        else
            show("credits_body", false)
        end
    end
end

local function send(action, extra)
    local msg_table = { action = action }
    if extra then
        for k, v in pairs(extra) do msg_table[k] = v end
    end
    msg.post("/game#script", "ui_action", msg_table)
end

local function on_click(self, x, y)
    local st = self.state
    if st == "TITLE" or st == "COMBOS" or st == "CREDITS" then
        local b = layout.hit_enabled(st, x, y)
        if b then send(b.action) end
        return
    end
    if st == "PAUSED" then
        local b = layout.hit_enabled(st, x, y)
        if b then send(b.action) end
        return
    end
    if st == "SETTINGS" then
        local b = layout.hit_enabled(st, x, y)
        if b then
            if b.field then
                send(b.action, { field = b.field })
            elseif b.bind_id then
                send("bind", { id = b.bind_id })
            else
                send(b.action)
            end
        end
        return
    end
    if st == "HOME_EDIT" then
        local b = layout.hit_enabled(st, x, y)
        if b then
            if b.id == "tab_mouse_box" or b.id == "tab_q_box" or b.id == "tab_r_box" then
                send("tab", { slot = b.slot })
            elseif b.field then
                send(b.action, { field = b.field, dir = b.dir })
            else
                send(b.action)
            end
        end
        return
    end
    if st == "REWARD" then
        local b = layout.hit_enabled(st, x, y)
        if b then send(b.action, { index = b.index }) end
        return
    end
    if st == "CAULDRON" then
        local b = layout.hit_enabled(st, x, y)
        if b then
            if b.field then
                send(b.action, { field = b.field })
            elseif b.slot then
                send(b.action, { slot = b.slot })
            else
                send(b.action)
            end
        end
        return
    end
    if st == "DEAD" or st == "WIN" or st == "STORY" or st == "ROLL" then
        send("continue")
    end
end

function init(self)
    self.state = "TITLE"
    self.hp = 100
    self.max_hp = 100
    self.s1 = nil
    self.s2 = nil
    self.s3 = nil
    self.room = 0
    self.inventory = nil
    self.reward_options = nil
    self.cauldron = nil
    self.preview = nil
    self.boss = nil
    self.boss_hp = 0
    self.boss_max_hp = 0
    self.flash = 0
    self.toast = nil
    self.casts = 0
    self.relic_tip = nil
    self.started = false

    -- The authored control hint (keep in sync with main/hud.gui -> help_text).
    -- Restored whenever no interaction banner is up.
    self.help_default = "WASD move   Mouse aim   LMB basic   Q/R spells   SPACE dash"

    -- Every node in main/hud.gui is positioned from the shared layout rects
    -- (apply_layout below); nothing is offset here.
    for _, id in ipairs(ALL_NODES) do
        if gui.get_node(id) == nil then
            print("HUD: missing node '" .. id .. "' in main/hud.gui")
        end
    end

    -- Phase B/C: position every screen from the shared layout rects and create
    -- the panel component nodes (border, fill, title bar) for COMBOS/CREDITS/CAULDRON.
    self.panel_combos = make_panel_nodes(layout.SCREENS.COMBOS.panel, hash("graphics"))
    self.panel_credits = make_panel_nodes(layout.SCREENS.CREDITS.panel, hash("graphics"))
    self.panel_cauldron = make_panel_nodes(layout.SCREENS.CAULDRON.panel, hash("graphics"))
    self.panel_home_edit = make_panel_nodes(layout.SCREENS.HOME_EDIT.panel, hash("graphics"))
    self.panel_paused = make_panel_nodes(layout.SCREENS.PAUSED.panel, hash("graphics"))
    self.panel_settings = make_panel_nodes(layout.SCREENS.SETTINGS.panel, hash("graphics"))
    self.editor = nil
    self.prompt = nil
    apply_layout(self)

    render(self)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("ui") then
        self.state = message.state or self.state
        self.hp = message.hp or self.hp
        self.max_hp = message.max_hp or self.max_hp
        self.s1 = message.s1
        self.s2 = message.s2
        self.s3 = message.s3
        self.dash_cd = message.dash_cd
        self.volume = message.volume
        self.bindings = message.bindings
        self.capture = message.capture
        self.editor = message.editor
        self.prompt = message.prompt
        self.hover_x = message.hover_x or self.hover_x
        self.hover_y = message.hover_y or self.hover_y
        self.room = message.room or self.room
        self.inventory = message.inventory or self.inventory
        self.relics = message.relics or self.relics
        self.reward_options = message.reward_options
        self.cauldron = message.cauldron or self.cauldron
        self.slot_names = message.slots
        self.casts = message.casts or (self.casts or 0)
        self.preview = message.preview
        self.boss = message.boss
        self.boss_hp = message.boss_hp or 0
        self.boss_max_hp = message.boss_max_hp or 0
        self.flash = message.flash or self.flash
        self.story_title = message.story_title
        self.story_body = message.story_body
        self.story_hint = message.story_hint
        self.roll_t = message.roll_t
        self.toast = message.toast
        if not self.started then
            self.started = true
            print("HUD ready")
        end
        render(self)
    elseif message_id == hash("click") then
        on_click(self, message.x or 0, message.y or 0)
    elseif message_id == hash("ui_audit") then
        -- F1 layout audit. Tolerance model (state it, don't argue it):
        --   * text width uses Cascadia's measured fixed advance, 1200/2048 em
        --     (0.58594 em), exact for this monospace font at the node's design
        --     size (size = base 14px x f mult, never averages glyph widths);
        --   * the container is the panel rect minus 32 px inner padding
        --     (16 px per side); DESIGN_W - 32 for full-screen panels;
        --     or the spec's max_w when set (narrow slots/cards);
        --   * vertical: line count x font size x LINE_HEIGHT (assumed 1.2 em)
        --     must fit the spec's max_h; a text is reported only if its WIDEST
        --     LINE exceeds max_w or its line block exceeds max_h;
        --   * node scale == spec.size / 14 everywhere (uniform pass in
        --     apply_layout), so width/height math is exact, not estimated.
        -- The human MUST press F1 on every converted screen and paste the
        -- printed UI AUDIT lines into the task log.
        local st = self.state
        local scr = layout.SCREENS[st]
        if not scr then
            print("UI AUDIT: no auditable screen in state " .. tostring(st))
            return
        end
        local problems = {}
        for _, p in ipairs(layout.audit_screen(st)) do problems[#problems + 1] = p end
        for _, p in ipairs(layout.audit_text_fit()) do problems[#problems + 1] = p end
        for id, spec in pairs(scr.texts or {}) do
            local node = n(id)
            if node then
                local s = gui.get_text(node) or ""
                local fs = spec.size or 14
                local w = layout.text_width(s, fs)
                local container = spec.max_w or ((scr.panel and scr.panel.w or layout.DESIGN_W) - 32)
                if w > container then
                    problems[#problems + 1] = st .. ": " .. id .. " overflows its panel (" .. string.format("%.0f", w) .. "px > " .. container .. "px)"
                end
                if spec.max_h then
                    local line_count = 1
                    for _ in s:gmatch("\n") do line_count = line_count + 1 end
                    local h = line_count * fs * layout.LINE_HEIGHT
                    if h > spec.max_h then
                        problems[#problems + 1] = st .. ": " .. id .. " vertical overflow (" .. line_count .. " line(s), " .. string.format("%.0f", h) .. "px > " .. spec.max_h .. "px)"
                    end
                end
            end
        end
        for _, p in ipairs(problems) do print("UI AUDIT: " .. p) end
        print("UI AUDIT: " .. #problems .. " problems")
    end
end
